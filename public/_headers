# Cloudflare Workers Static Assets 自定义响应头
#
# 放在 public/ 下：Astro 构建时会复制到 dist/，切分脚本再分发给 dist-zh / dist-en。
# 注意：_headers 只作用于静态资产响应，不作用于 Worker 生成的 /api/* 响应，
# 后者需在 src/worker/index.ts 里单独设置。

/*
  # 禁止 MIME 嗅探：浏览器不再把 text/plain 当 HTML 执行
  X-Content-Type-Options: nosniff
  # 跨站跳转时不泄露完整 URL（对方是本站时保留完整路径）
  Referrer-Policy: strict-origin-when-cross-origin
  # 禁止被 iframe 嵌套，防点击劫持
  X-Frame-Options: SAMEORIGIN
  # 本站不需要摄像头/麦克风/定位等能力，直接关掉
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  # 强制 HTTPS。仅作用于 skill.gautown.top 及其子域，不影响 gautown.top 其它站点
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# 构建产物带内容哈希，可长期强缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 装饰性静态资源：文件名没有内容哈希，不能 immutable（换图后要能生效），
# 但也不该每次访问都回源做条件请求。
# 这几个文件每个页面都要用到（logo 在页头、favicon 由浏览器自动请求、
# hero 背景只在首页用），原来走的是 max-age=0,must-revalidate，
# 等于每次都多一次额外往返。给 1 小时强缓存，重复访问零请求，换图最迟 1 小时生效。
/logo.svg
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=3600
/hero.webp
  Cache-Control: public, max-age=3600
/hero.png
  Cache-Control: public, max-age=3600
/banner.png
  Cache-Control: public, max-age=3600

# 数据文件每次同步都会变，只允许短时缓存
/skills-index.json
  Cache-Control: public, max-age=0, must-revalidate

# 爬虫入口不应被缓存成旧版本
/sitemap*.xml
  Cache-Control: public, max-age=3600
