{
  "name": "hamster-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "ai-classify": "node scripts/ai-classify.mjs",
    "ai-classify:status": "node scripts/ai-classify.mjs --status",
    "ai-classify:dry": "node scripts/ai-classify.mjs --dry-run",
    "test": "node --test scripts/*.test.mjs",
    "og-image": "node scripts/make-og-image.mjs",
    "split": "node scripts/split-assets.mjs",
    "audit": "node scripts/audit.mjs",
    "triage": "node scripts/triage.mjs",
    "predeploy": "node scripts/predeploy.mjs",
    "deploy:zh": "npm run predeploy && npx --yes wrangler@4 deploy -c wrangler.zh.jsonc",
    "deploy:en": "npm run predeploy && npx --yes wrangler@4 deploy -c wrangler.en.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "marked": "^18.0.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}