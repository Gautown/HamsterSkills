---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import SkillDetail from '../../../components/SkillDetail.astro'

export async function getStaticPaths() {
  const skills = await getCollection('skills')
  return skills.map(entry => ({ params: { slug: entry.id } }))
}

const { slug } = Astro.params as { slug: string }
const skills = await getCollection('skills')
const [entry] = skills.filter(s => s.id === slug)
if (!entry) return
---

<Layout lang="en" title={entry.data.titleEn}>
  <SkillDetail locale="en" entry={entry} skills={skills} />
</Layout>
