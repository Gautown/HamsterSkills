---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import CategoryIndex from '../../../components/CategoryIndex.astro'
import { T } from '../../../i18n/translations'

const skills = await getCollection('skills')
const t = T.en
---

<Layout
  lang="en"
  title={t.categoriesTitle}
  description={`Browse ${skills.length} AI skills across 10 use-case categories — development, design, writing, data, office and more. Copy & go.`}
>
  <CategoryIndex locale="en" skills={skills} />
</Layout>
