---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import CategoryPage from '../../../components/CategoryPage.astro'
import { CATEGORY_KEYS, CATEGORY_NAMES, type CategoryKey } from '../../../lib/categories'

export function getStaticPaths() {
  return CATEGORY_KEYS.map(category => ({ params: { category } }))
}

const skills = await getCollection('skills')
const category = Astro.params.category as CategoryKey
const inCategory = skills.filter((s) => s.data.category === category)
---

<Layout
  lang="en"
  title={CATEGORY_NAMES.en[category]}
  description={`${inCategory.length} AI skills in the "${CATEGORY_NAMES.en[category]}" category, with purpose descriptions and source repositories. One-click copy.`}
>
  <CategoryPage locale="en" category={category} skills={skills} />
</Layout>
