---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import CategoryPage from '../../components/CategoryPage.astro'
import { CATEGORY_KEYS, CATEGORY_NAMES, type CategoryKey } from '../../lib/categories'

export function getStaticPaths() {
  return CATEGORY_KEYS.map(category => ({ params: { category } }))
}

const skills = await getCollection('skills')
const category = Astro.params.category as CategoryKey
const inCategory = skills.filter((s) => s.data.category === category)
---

<Layout
  lang="zh"
  title={CATEGORY_NAMES.zh[category]}
  description={`「${CATEGORY_NAMES.zh[category]}」分类下的 ${inCategory.length} 个 AI Skill，附用途说明与来源仓库，可一键复制 Prompt。`}
  alternate={{ lang: 'en', href: `/en/categories/${category}/` }}
>
  <CategoryPage locale="zh" category={category} skills={skills} />
</Layout>
