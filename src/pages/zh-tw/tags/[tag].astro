---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import TagPage from '../../../components/TagPage.astro'
import { buildTagPaths } from '../../../lib/tags'

export async function getStaticPaths() {
  const skills = await getCollection('skills')
  return buildTagPaths(skills).map(({ slug, tags }) => ({ params: { tag: slug }, props: { tags } }))
}

const skills = await getCollection('skills')
const { tags } = Astro.props as { tags: string[] }
const tagged = skills.filter((s) => s.data.tags?.includes(tags[0]))
---

<Layout
  lang="zh-tw"
  title={`#${tags[0]}`}
  description={`帶有 #${tags[0]} 標籤的 ${tagged.length} 個 AI Skill，${tags.slice(0, 4).map((x) => '#' + x).join(' ')}`}
>
  <TagPage locale="zh-tw" tags={tags} skills={skills} />
</Layout>
