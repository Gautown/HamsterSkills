---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import CategoryPage from '../../../components/CategoryPage.astro'
import { CATEGORY_KEYS, CATEGORY_NAMES, type CategoryKey } from '../../../lib/categories'

export function getStaticPaths() {
  return CATEGORY_KEYS.map(category => ({ params: { category } }))
}

const skills = await getCollection('skills')
const category = Astro.params.category as CategoryKey
const inCategory = skills.filter((s) => s.data.category === category)
---

<Layout
  lang="zh-tw"
  title={CATEGORY_NAMES['zh-tw'][category]}
  description={`「${CATEGORY_NAMES['zh-tw'][category]}」分類下的 ${inCategory.length} 個 AI Skill，附用途說明與來源倉庫，可一鍵複製 Prompt。`}
>
  <CategoryPage locale="zh-tw" category={category} skills={skills} />
</Layout>
