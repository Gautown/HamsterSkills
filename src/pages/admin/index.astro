---
/**
 * 管理后台页面（仅站长使用）。
 *
 * - 挂在简中根路径 /admin/，由 zh Worker 的静态资产服务
 *  （split-assets.mjs：根路径页面全部落在 dist-zh）。
 * - 三重防索引：noindex meta（Layout prop）+ robots.txt Disallow + sitemap filter。
 * - 纯浏览器端单页：所有数据经 /api/admin/*（Worker 端点，见 src/worker/admin.ts），
 *   页面本身零机密——没登录只能看到一张登录卡。
 * - 首次使用：未初始化时展开「首次初始化」，需要 ADMIN_SETUP_KEY
 *   （wrangler secret），防止陌生人抢注管理员。
 */
import Layout from '../../layouts/Layout.astro'
---

<Layout lang="zh" title="管理后台" path="/admin/" noindex>
  <div class="admin-wrap">
    <h1 class="admin-h1">管理后台</h1>
    <p class="admin-sub">站点参数与广告模块配置 · 仅站长使用</p>

    <section class="admin-card" id="auth-card">
      <h2 class="admin-h2">登录</h2>
      <form id="login-form" class="admin-form" autocomplete="off">
        <label class="admin-label">
          <span>账户</span>
          <input name="username" required maxlength="32" autocomplete="username" />
        </label>
        <label class="admin-label">
          <span>密码</span>
          <input name="password" type="password" required maxlength="128" autocomplete="current-password" />
        </label>
        <button class="admin-btn" type="submit">登录</button>
        <p class="admin-msg" id="login-msg" role="status"></p>
      </form>

      <details class="admin-setup">
        <summary>首次初始化（需要引导密钥）</summary>
        <form id="setup-form" class="admin-form" autocomplete="off">
          <label class="admin-label">
            <span>引导密钥 ADMIN_SETUP_KEY</span>
            <input name="setupKey" type="password" required autocomplete="off" />
          </label>
          <label class="admin-label">
            <span>账户</span>
            <input name="username" required maxlength="32" autocomplete="username" />
          </label>
          <label class="admin-label">
            <span>密码（8-128 位）</span>
            <input name="password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" />
          </label>
          <button class="admin-btn" type="submit">创建管理员</button>
          <p class="admin-msg" id="setup-msg" role="status"></p>
        </form>
      </details>
    </section>

    <section class="admin-card" id="panel" hidden>
      <div class="admin-panel-head">
        <h2 class="admin-h2">控制台 <span class="admin-who" id="who"></span></h2>
        <button id="logout-btn" class="admin-btn admin-btn-ghost" type="button">登出</button>
      </div>

      <form id="site-form" class="admin-form">
        <h3 class="admin-h3">站点参数</h3>
        <p class="admin-hint">留空的字段沿用构建期默认值；改动对全站五语言即时生效（页面缓存约 2-5 分钟）。</p>
        <label class="admin-label">
          <span>站点名称</span>
          <input name="name" maxlength="40" placeholder="如：仓鼠AI技能库" />
        </label>
        <label class="admin-label">
          <span>站点描述</span>
          <input name="desc" maxlength="120" placeholder="页脚与展示用一句话介绍" />
        </label>

        <h3 class="admin-h3">导航栏 Logo</h3>
        <div class="admin-logo">
          <img id="logo-preview" src="/logo.svg" alt="当前 logo 预览" width="48" height="48" />
          <div class="admin-logo-actions">
            <input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" />
            <button class="admin-btn admin-btn-ghost" type="button" id="logo-reset">恢复默认</button>
          </div>
        </div>
        <p class="admin-hint">png / jpeg / webp / gif / svg，≤200KB；选择文件后自动上传（无需再点保存配置）。</p>
        <p class="admin-msg" id="logo-msg" role="status"></p>

        <h3 class="admin-h3">首页 Hero 文案</h3>
        <p class="admin-hint">仅作用于五语言首页首屏；标题留空沿用各语言默认文案。</p>
        <label class="admin-label">
          <span>主标题</span>
          <input name="heroTitle" maxlength="60" placeholder="如：仓鼠AI技能库" />
        </label>
        <label class="admin-label">
          <span>副标题</span>
          <input name="heroSubtitle" maxlength="160" placeholder="一句话说明站点做什么" />
        </label>
        <label class="admin-label">
          <span>主按钮文案</span>
          <input name="heroCta1" maxlength="20" placeholder="如：浏览全部技能" />
        </label>
        <label class="admin-label">
          <span>次按钮文案</span>
          <input name="heroCta2" maxlength="20" placeholder="如：按分类浏览" />
        </label>

        <h3 class="admin-h3">页脚</h3>
        <label class="admin-label">
          <span>页脚备注</span>
          <input name="footerNote" maxlength="80" placeholder="替换页脚右侧的 Built with Astro" />
        </label>
        <label class="admin-label">
          <span>版权行</span>
          <input name="copyright" maxlength="120" placeholder="如：© 2026 仓鼠AI技能库（留空则不显示）" />
        </label>

        <h3 class="admin-h3">页面内容</h3>
        <p class="admin-hint">
          覆盖「关于 / 联系 / 隐私政策」页的正文；留空沿用默认文案。覆盖值为单一文本，对全部语言版本生效。
        </p>
        <details class="admin-pages">
          <summary>关于页</summary>
          <label class="admin-label">
            <span>副标题</span>
            <input name="aboutSub" maxlength="160" />
          </label>
          <label class="admin-label">
            <span>「这是什么」正文</span>
            <textarea name="aboutWhatBody" maxlength="600" rows="3"></textarea>
          </label>
          <label class="admin-label">
            <span>「怎么使用」复制提示词段</span>
            <textarea name="aboutHowCopy" maxlength="300" rows="2"></textarea>
          </label>
          <label class="admin-label">
            <span>「怎么使用」一键安装段</span>
            <textarea name="aboutHowInstall" maxlength="300" rows="2"></textarea>
          </label>
          <label class="admin-label">
            <span>「内容来源」正文</span>
            <textarea name="aboutSourceBody" maxlength="400" rows="2"></textarea>
          </label>
        </details>
        <details class="admin-pages">
          <summary>联系页</summary>
          <label class="admin-label">
            <span>副标题</span>
            <input name="contactSub" maxlength="300" />
          </label>
          <label class="admin-label">
            <span>联系邮箱（设置后联系页显示邮箱卡片）</span>
            <input name="contactEmail" type="email" maxlength="120" placeholder="如 contact@example.com" />
          </label>
          <label class="admin-label">
            <span>GitHub 渠道说明</span>
            <textarea name="contactGithubBody" maxlength="400" rows="2"></textarea>
          </label>
          <label class="admin-label">
            <span>版权与更正正文</span>
            <textarea name="contactCopyrightBody" maxlength="400" rows="2"></textarea>
          </label>
        </details>
        <details class="admin-pages">
          <summary>隐私政策页</summary>
          <label class="admin-label">
            <span>副标题</span>
            <input name="privacySub" maxlength="300" />
          </label>
          <label class="admin-label">
            <span>广告与个性化（Ezoic 披露段——与平台指定措辞对齐处）</span>
            <textarea name="privacyAdsBody" maxlength="1200" rows="4"></textarea>
          </label>
          <label class="admin-label">
            <span>浏览器本地存储</span>
            <textarea name="privacyDataBody" maxlength="800" rows="3"></textarea>
          </label>
          <label class="admin-label">
            <span>Cookie 与类似技术</span>
            <textarea name="privacyCookiesBody" maxlength="800" rows="3"></textarea>
          </label>
          <label class="admin-label">
            <span>聊天助手</span>
            <textarea name="privacyChatBody" maxlength="800" rows="3"></textarea>
          </label>
          <label class="admin-label">
            <span>第三方服务</span>
            <textarea name="privacyThirdBody" maxlength="800" rows="3"></textarea>
          </label>
          <label class="admin-label">
            <span>数据保留</span>
            <textarea name="privacyRetentionBody" maxlength="800" rows="3"></textarea>
          </label>
          <label class="admin-label">
            <span>你的权利</span>
            <textarea name="privacyRightsBody" maxlength="800" rows="3"></textarea>
          </label>
          <label class="admin-label">
            <span>政策更新</span>
            <textarea name="privacyChangesBody" maxlength="800" rows="2"></textarea>
          </label>
          <label class="admin-label">
            <span>联系我们</span>
            <textarea name="privacyContactBody" maxlength="800" rows="2"></textarea>
          </label>
        </details>

        <h3 class="admin-h3">广告模块（Ezoic）</h3>
        <p class="admin-hint">Side Rails 为宽屏两侧闲置边栏竖幅，仅首页与技能详情页候选。</p>
        <label class="admin-check">
          <input name="adsEnabled" type="checkbox" />
          <span>启用广告（总开关）</span>
        </label>
        <label class="admin-label">
          <span>Side Rails</span>
          <select name="sideRails">
            <option value="left">仅左侧</option>
            <option value="both">左右两侧</option>
            <option value="off">关闭</option>
          </select>
        </label>
        <label class="admin-check">
          <input name="anchor" type="checkbox" />
          <span>底部 Anchor 横幅</span>
        </label>
        <label class="admin-check">
          <input name="vignette" type="checkbox" />
          <span>插屏（Vignette）</span>
        </label>
        <button class="admin-btn" type="submit">保存配置</button>
        <p class="admin-msg" id="site-msg" role="status"></p>
      </form>

      <form id="cred-form" class="admin-form">
        <h3 class="admin-h3">修改账户</h3>
        <label class="admin-label">
          <span>当前密码</span>
          <input name="currentPassword" type="password" required autocomplete="current-password" />
        </label>
        <label class="admin-label">
          <span>新账户（留空不改）</span>
          <input name="username" maxlength="32" autocomplete="username" />
        </label>
        <label class="admin-label">
          <span>新密码（留空不改）</span>
          <input name="newPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" />
        </label>
        <button class="admin-btn" type="submit">更新账户</button>
        <p class="admin-msg" id="cred-msg" role="status"></p>
      </form>
    </section>
  </div>
</Layout>

<style>
  .admin-wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 48px 20px 96px;
  }
  .admin-h1 {
    font-size: 26px;
    font-weight: 300;
    letter-spacing: -0.26px;
    margin: 0 0 4px;
  }
  .admin-sub {
    color: var(--muted);
    font-size: 13px;
    margin: 0 0 28px;
  }
  .admin-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: rgba(0, 55, 112, 0.08) 0 1px 3px;
  }
  .admin-h2 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 16px;
  }
  .admin-h3 {
    font-size: 14px;
    font-weight: 600;
    margin: 24px 0 4px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .admin-h3:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .admin-hint {
    color: var(--muted);
    font-size: 12px;
    margin: 0 0 14px;
  }
  .admin-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .admin-label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-secondary, var(--muted));
  }
  .admin-label span {
    font-weight: 500;
  }
  .admin-form input,
  .admin-form select,
  .admin-form textarea {
    font: inherit;
    font-size: 14px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: inherit;
    outline: none;
  }
  .admin-form input:focus-visible,
  .admin-form select:focus-visible,
  .admin-form textarea:focus-visible {
    border-color: var(--brand, #533afd);
    box-shadow: 0 0 0 3px rgba(83, 58, 253, 0.15);
  }
  .admin-form textarea {
    resize: vertical;
    min-height: 64px;
    line-height: 1.7;
  }
  /* 页面内容分组（可折叠的 details，避免管理页被长表单淹没） */
  .admin-pages {
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .admin-pages summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
  }
  .admin-pages[open] {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 6px;
  }
  .admin-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    cursor: pointer;
  }
  .admin-check input {
    width: 16px;
    height: 16px;
    accent-color: #533afd;
  }
  .admin-logo {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .admin-logo img {
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 4px;
    background: var(--surface);
  }
  .admin-logo-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .admin-logo-actions input[type='file'] {
    font-size: 12px;
    max-width: 320px;
  }
  .admin-btn {
    align-self: flex-start;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    background: #533afd;
    border: 0;
    border-radius: var(--radius-pill, 999px);
    padding: 9px 20px;
    cursor: pointer;
  }
  .admin-btn:hover {
    background: #4434d4;
  }
  .admin-btn-ghost {
    background: transparent;
    color: var(--ink-secondary, var(--muted));
    border: 1px solid var(--line);
  }
  .admin-btn-ghost:hover {
    background: var(--surface);
    color: inherit;
  }
  .admin-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .admin-panel-head .admin-h2 {
    margin: 0;
  }
  .admin-who {
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }
  .admin-msg {
    min-height: 1.2em;
    margin: 0;
    font-size: 13px;
    color: #b3261e;
  }
  .admin-msg.is-ok {
    color: #1a7f37;
  }
  .admin-setup {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .admin-setup summary {
    cursor: pointer;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .admin-setup[open] .admin-form {
    margin-top: 14px;
  }
</style>

<script>
  /**
   * 管理后台交互：
   * - 会话探针决定显示登录卡还是控制台；
   * - 所有写操作走 /api/admin/*，凭 HttpOnly 会话 cookie；
   * - 本地预览（无 Worker）时所有请求 404，页面停在登录卡——预期行为。
   */
  type Json = Record<string, unknown>

  const $ = <T extends HTMLElement>(sel: string): T => document.querySelector(sel) as T
  const field = (form: HTMLFormElement, name: string): HTMLInputElement =>
    form.elements.namedItem(name) as HTMLInputElement
  /** 文本/多行字段取用（textarea 与 input 都有 value；checkbox 走 field().checked） */
  const fieldText = (form: HTMLFormElement, name: string): HTMLInputElement | HTMLTextAreaElement =>
    form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement

  /**
   * 页面内容表单字段 → [配置分组, 组内键名]。
   * 填充与提交共用同一张表，防止两侧漂移（新增字段只改这一处）。
   */
  const PAGE_FIELDS: Array<[string, 'about' | 'contact' | 'privacy', string]> = [
    ['aboutSub', 'about', 'sub'],
    ['aboutWhatBody', 'about', 'whatBody'],
    ['aboutHowCopy', 'about', 'howCopy'],
    ['aboutHowInstall', 'about', 'howInstall'],
    ['aboutSourceBody', 'about', 'sourceBody'],
    ['contactSub', 'contact', 'sub'],
    ['contactEmail', 'contact', 'email'],
    ['contactGithubBody', 'contact', 'githubBody'],
    ['contactCopyrightBody', 'contact', 'copyrightBody'],
    ['privacySub', 'privacy', 'sub'],
    ['privacyAdsBody', 'privacy', 'adsBody'],
    ['privacyDataBody', 'privacy', 'dataBody'],
    ['privacyCookiesBody', 'privacy', 'cookiesBody'],
    ['privacyChatBody', 'privacy', 'chatBody'],
    ['privacyThirdBody', 'privacy', 'thirdBody'],
    ['privacyRetentionBody', 'privacy', 'retentionBody'],
    ['privacyRightsBody', 'privacy', 'rightsBody'],
    ['privacyChangesBody', 'privacy', 'changesBody'],
    ['privacyContactBody', 'privacy', 'contactBody'],
  ]

  async function api(path: string, init: RequestInit = {}): Promise<{ ok: boolean; data: Json }> {
    const res = await fetch(path, { credentials: 'same-origin', ...init })
    let data: Json = {}
    try {
      data = (await res.json()) as Json
    } catch {
      /* 非 JSON 响应（如静态服务器直接 404）按空对象处理 */
    }
    return { ok: res.ok, data }
  }

  function say(id: string, text: string, ok = false) {
    const el = $(`#${id}`)
    el.textContent = text
    el.classList.toggle('is-ok', ok)
  }

  function errMsg(data: Json, fallback: string): string {
    return typeof data.error === 'string' ? data.error : fallback
  }

  /* ------------------------------ 登录 / 初始化 ------------------------------ */

  $('#login-form').addEventListener('submit', async e => {
    e.preventDefault()
    const form = e.currentTarget as HTMLFormElement
    const { ok, data } = await api('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        username: String(field(form, 'username').value),
        password: String(field(form, 'password').value),
      }),
    })
    if (!ok) {
      say('login-msg', errMsg(data, '登录失败'))
      if (data.needSetup) say('login-msg', '管理员尚未初始化，请展开下方「首次初始化」创建账户')
      return
    }
    enterPanel(String(data.username ?? ''))
  })

  $('#setup-form').addEventListener('submit', async e => {
    e.preventDefault()
    const form = e.currentTarget as HTMLFormElement
    const { ok, data } = await api('/api/admin/setup', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-setup-key': String(field(form, 'setupKey').value),
      },
      body: JSON.stringify({
        username: String(field(form, 'username').value),
        password: String(field(form, 'password').value),
      }),
    })
    if (!ok) {
      say('setup-msg', errMsg(data, '初始化失败'))
      return
    }
    say('setup-msg', '管理员已创建，请收起此面板并登录', true)
  })

  /* ------------------------------ 控制台 ------------------------------ */

  function enterPanel(username: string) {
    $('#auth-card').hidden = true
    $('#panel').hidden = false
    $('#who').textContent = `· ${username}`
    void loadConfig()
  }

  async function loadConfig() {
    const { ok, data } = await api('/api/admin/config')
    if (!ok) {
      // 会话刚失效：回到登录卡
      $('#panel').hidden = true
      $('#auth-card').hidden = false
      say('login-msg', errMsg(data, '会话已过期，请重新登录'))
      return
    }
    const cfg = (data.config ?? {}) as {
      site?: Record<string, unknown>
      about?: Record<string, unknown>
      contact?: Record<string, unknown>
      privacy?: Record<string, unknown>
      ads?: Record<string, unknown>
      logo?: { custom?: boolean; v?: string }
    }
    const form = $('#site-form') as HTMLFormElement
    for (const key of ['name', 'desc', 'footerNote', 'copyright', 'heroTitle', 'heroSubtitle', 'heroCta1', 'heroCta2']) {
      const value = cfg.site?.[key]
      field(form, key).value = typeof value === 'string' ? value : ''
    }
    for (const [formName, group, key] of PAGE_FIELDS) {
      const value = cfg[group]?.[key]
      fieldText(form, formName).value = typeof value === 'string' ? value : ''
    }
    field(form, 'adsEnabled').checked = cfg.ads?.enabled !== false
    field(form, 'sideRails').value = typeof cfg.ads?.sideRails === 'string' ? cfg.ads.sideRails : 'left'
    field(form, 'anchor').checked = cfg.ads?.anchor === true
    field(form, 'vignette').checked = cfg.ads?.vignette === true
    updateLogoPreview(cfg.logo?.custom === true && cfg.logo.v ? `/api/site-logo?v=${cfg.logo.v}` : '/logo.svg')
  }

  $('#site-form').addEventListener('submit', async e => {
    e.preventDefault()
    const form = e.currentTarget as HTMLFormElement

    /* 页面内容三组按同一张表收集；服务端 normalizeSiteConfig 负责截断与丢弃空值 */
    const about: Record<string, string> = {}
    const contact: Record<string, string> = {}
    const privacy: Record<string, string> = {}
    for (const [formName, group, key] of PAGE_FIELDS) {
      const value = fieldText(form, formName).value
      if (group === 'about') about[key] = value
      else if (group === 'contact') contact[key] = value
      else privacy[key] = value
    }

    const { ok, data } = await api('/api/admin/config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        site: {
          name: field(form, 'name').value,
          desc: field(form, 'desc').value,
          footerNote: field(form, 'footerNote').value,
          copyright: field(form, 'copyright').value,
          heroTitle: field(form, 'heroTitle').value,
          heroSubtitle: field(form, 'heroSubtitle').value,
          heroCta1: field(form, 'heroCta1').value,
          heroCta2: field(form, 'heroCta2').value,
        },
        about,
        contact,
        privacy,
        ads: {
          enabled: field(form, 'adsEnabled').checked,
          sideRails: field(form, 'sideRails').value,
          anchor: field(form, 'anchor').checked,
          vignette: field(form, 'vignette').checked,
        },
      }),
    })
    say('site-msg', ok ? '已保存，约 2-5 分钟内全站生效' : errMsg(data, '保存失败'), ok)
  })

  /* ------------------------------ 导航栏 Logo ------------------------------ */

  const logoInput = $('#logo-file') as HTMLInputElement
  const logoPreview = $('#logo-preview') as HTMLImageElement
  const updateLogoPreview = (src: string) => {
    logoPreview.src = src
  }

  logoInput.addEventListener('change', async () => {
    const file = logoInput.files?.[0]
    if (!file) return
    if (file.size > 200 * 1024) {
      say('logo-msg', '图片需在 200KB 以内')
      logoInput.value = ''
      return
    }
    const dataUrl = await new Promise<string>((resolve, reject) => {
      const reader = new FileReader()
      reader.onload = () => resolve(String(reader.result))
      reader.onerror = () => reject(reader.error)
      reader.readAsDataURL(file)
    })
    const { ok, data } = await api('/api/admin/logo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dataUrl }),
    })
    logoInput.value = ''
    if (!ok) {
      say('logo-msg', errMsg(data, '上传失败'))
      return
    }
    const logo = data.logo as { v?: string } | undefined
    updateLogoPreview(`/api/site-logo?v=${logo?.v ?? Date.now()}`)
    say('logo-msg', '已更新（全站最长约 5 分钟内可见）', true)
  })

  $('#logo-reset').addEventListener('click', async () => {
    const { ok, data } = await api('/api/admin/logo', { method: 'DELETE' })
    if (!ok) {
      say('logo-msg', errMsg(data, '恢复失败'))
      return
    }
    updateLogoPreview('/logo.svg')
    say('logo-msg', '已恢复默认 logo', true)
  })

  $('#cred-form').addEventListener('submit', async e => {
    e.preventDefault()
    const form = e.currentTarget as HTMLFormElement
    const { ok, data } = await api('/api/admin/credentials', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        currentPassword: field(form, 'currentPassword').value,
        username: field(form, 'username').value,
        newPassword: field(form, 'newPassword').value,
      }),
    })
    if (!ok) {
      say('cred-msg', errMsg(data, '更新失败'))
      return
    }
    say('cred-msg', '账户已更新', true)
    field(form, 'currentPassword').value = ''
    field(form, 'username').value = ''
    field(form, 'newPassword').value = ''
  })

  $('#logout-btn').addEventListener('click', async () => {
    await api('/api/admin/logout', { method: 'POST' })
    location.reload()
  })

  /* ------------------------------ 启动 ------------------------------ */

  ;(async () => {
    const { ok, data } = await api('/api/admin/session')
    if (ok) enterPanel(String(data.username ?? ''))
  })()
</script>
