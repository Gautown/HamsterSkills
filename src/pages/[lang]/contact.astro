---
import ContactPage from '../../components/ContactPage.astro'
import { NON_DEFAULT_LOCALES, localeFromParams } from '../../lib/languages'

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }))
}
---

<ContactPage lang={localeFromParams(Astro.params.lang)} />
