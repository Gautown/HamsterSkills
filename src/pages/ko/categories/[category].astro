---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import CategoryPage from '../../../components/CategoryPage.astro'
import { CATEGORY_KEYS, CATEGORY_NAMES, type CategoryKey } from '../../../lib/categories'

export function getStaticPaths() {
  return CATEGORY_KEYS.map(category => ({ params: { category } }))
}

const skills = await getCollection('skills')
const category = Astro.params.category as CategoryKey
const inCategory = skills.filter((s) => s.data.category === category)
---

<Layout
  lang="ko"
  title={CATEGORY_NAMES.ko[category]}
  description={`"${CATEGORY_NAMES.ko[category]}" 카테고리의 ${inCategory.length}개 AI 스킬 — 용도 설명과 출처 저장소 포함, 원클릭 복사.`}
>
  <CategoryPage locale="ko" category={category} skills={skills} />
</Layout>
