---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import CategoryIndex from '../../../components/CategoryIndex.astro'
import { T } from '../../../i18n/translations'

const skills = await getCollection('skills')
const t = T.ms
---

<Layout
  lang="ms"
  title={t.categoriesTitle}
  description={`Layari ${skills.length} kemahiran AI merentas 10 kategori kes penggunaan — pembangunan, reka bentuk, penulisan, data, pejabat dan banyak lagi. Salin & terus guna.`}
>
  <CategoryIndex locale="ms" skills={skills} />
</Layout>
