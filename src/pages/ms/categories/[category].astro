---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import CategoryPage from '../../../components/CategoryPage.astro'
import { CATEGORY_KEYS, CATEGORY_NAMES, type CategoryKey } from '../../../lib/categories'

export function getStaticPaths() {
  return CATEGORY_KEYS.map(category => ({ params: { category } }))
}

const skills = await getCollection('skills')
const category = Astro.params.category as CategoryKey
const inCategory = skills.filter((s) => s.data.category === category)
---

<Layout
  lang="ms"
  title={CATEGORY_NAMES.ms[category]}
  description={`${inCategory.length} kemahiran AI dalam kategori "${CATEGORY_NAMES.ms[category]}" — lengkap dengan penerangan tujuan dan repositori sumber. Salin satu klik.`}
>
  <CategoryPage locale="ms" category={category} skills={skills} />
</Layout>
