---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import SkillDetail from '../../components/SkillDetail.astro'

export async function getStaticPaths() {
  const skills = await getCollection('skills')
  return skills.map(entry => ({ params: { slug: entry.id } }))
}

const { slug } = Astro.params as { slug: string }
const skills = await getCollection('skills')
const [entry] = skills.filter(s => s.id === slug)
if (!entry) return
---

<Layout
  lang="zh"
  ezAds
  title={entry.data.title}
  description={entry.data.description}
  path={`/skills/${entry.id}/`}
  skill={{
    id: entry.id,
    title: entry.data.title,
    category: entry.data.category,
    description: entry.data.description,
  }}
>
  <SkillDetail locale="zh" entry={entry} skills={skills} />
</Layout>
