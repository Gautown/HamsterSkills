---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ChatWidget from '../components/ChatWidget.astro'
import { T, type Locale } from '../i18n/translations'

interface Props {
  lang: Locale
  title?: string
  /** 页面描述；详情页传 skill 自身的描述 */
  description?: string
  /** 该页面的站点内路径（如 /skills/pdf），用于拼 canonical 与 og:url */
  path?: string
  /**
   * 同一内容的另一种语言版本的绝对 URL。
   *
   * 站内中英是同一批内容的两套 URL（zh 在根、en 在 /en/），
   * 没有 hreflang 互指时搜索引擎无法判断哪套权威，
   * 存在两套互相稀释的风险（典型的重复内容形态）。
   */
  alternate?: { lang: string; href: string }
  /** og:type；详情页传 article 类语义，其余留空按 website */
  ogType?: string
  /**
   * 禁止索引。搜索结果页用：内容由 URL 参数决定，没有稳定内容可抓，
   * 参数页若被索引会造成大量重复内容。
   */
  noindex?: boolean
  /** 注入给客户端脚本的文案包（JSON 字符串） */
  i18n?: string
  /** 注入给客户端脚本的卡片渲染配置（JSON 字符串） */
  cards?: string
  /**
   * 当前页面的技能信息。仅技能详情页传入，
   * 聊天窗会把它作为上下文发给后端，让回答能结合这条技能展开。
   */
  skill?: {
    id: string
    title: string
    category?: string
    description?: string
  }
}

const { lang, title, description, path, alternate, ogType, noindex, i18n, cards, skill } = Astro.props
const t = T[lang]

/*
 * canonical / og:url 必须是绝对 URL，否则搜索引擎无法正确判断页面归属与去重。
 * Astro.site 来自 astro.config.mjs 的 site（构建时由 SITE_URL 环境变量注入），
 * 缺失时回退到正式域名，避免构建产物里出现相对路径。
 */
const SITE_ORIGIN = Astro.site?.origin ?? 'https://skill.gautown.top'
const pathname = path ?? Astro.url.pathname
const canonical = new URL(pathname, SITE_ORIGIN).href
const pageTitle = title ? `${title} · ${t.siteName}` : t.siteName
const pageDesc = description ?? t.siteDesc
/*
 * OG 图必须是 PNG：Twitter / Facebook / Slack / LinkedIn 的图片抓取器
 * 普遍不支持 SVG（各家爬虫的已知限制，与浏览器能否显示无关），
 * 而 og:image 恰恰只会被这些爬虫消费。此前这里指向 /og.svg，
 * 而那个文件根本不存在 —— 线上实测 404，社交分享从来没出过图。
 * 改由 scripts/make-og-image.mjs 生成 public/og.png。
 */
const ogImage = new URL('/og.png', SITE_ORIGIN).href
/** hreflang 必须是绝对 URL */
const alternateHref = alternate ? new URL(alternate.href, SITE_ORIGIN).href : null
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      /*
       * localStorage 读取必须 try/catch：Safari 无痕模式、站点数据被禁用、
       * 或以 file:// 打开时，访问它会抛 SecurityError。
       * 不兜住的话这行抛错会中断整段内联脚本。
       * 读不到就走 CSS 的系统主题兜底，功能不受影响。
       */
      try {
        const __t = localStorage.getItem('hamster:theme')
        if (__t) document.documentElement.dataset.theme = __t
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- canonical：告诉搜索引擎本页的唯一权威地址（站内中英同源时尤其重要） -->
    <link rel="canonical" href={canonical} />

    {/*
      hreflang：中英两套 URL 互指，声明「这是同一内容的不同语言版本」。
      没有它，搜索引擎只能自行猜测哪套权威，两套会互相稀释。
    */}
    <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonical} />
    {alternateHref && <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternateHref} />}
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* 图片本身没有信息量，但 alt 是无障碍与部分平台的可读性要求 */}
    <meta property="og:image:alt" content={`${t.siteName} — ${t.siteDesc}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${t.siteName} — ${t.siteDesc}`} />

    <title>{pageTitle}</title>
  </head>
  <body
    data-i18n={i18n}
    data-cards={cards}
  >
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    {/* 全站聊天窗：固定在视口右边缘、垂直居中 */}
    <ChatWidget lang={lang} skill={skill} />
  </body>
</html>