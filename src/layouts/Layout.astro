---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ChatWidget from '../components/ChatWidget.astro'
import { T, type Locale } from '../i18n/translations'
import { LANG_META, LOCALES, stripBase } from '../lib/languages'

interface Props {
  lang: Locale
  title?: string
  /** 页面描述；详情页传 skill 自身的描述 */
  description?: string
  /** 该页面的站点内路径（如 /skills/pdf），用于拼 canonical 与 og:url */
  path?: string
  /** og:type；详情页传 article 类语义，其余留空按 website */
  ogType?: string
  /**
   * 禁止索引。搜索结果页用：内容由 URL 参数决定，没有稳定内容可抓，
   * 参数页若被索引会造成大量重复内容。
   */
  noindex?: boolean
  /** 注入给客户端脚本的文案包（JSON 字符串） */
  i18n?: string
  /** 注入给客户端脚本的卡片渲染配置（JSON 字符串） */
  cards?: string
  /**
   * 当前页面的技能信息。仅技能详情页传入，
   * 聊天窗会把它作为上下文发给后端，让回答能结合这条技能展开。
   */
  skill?: {
    id: string
    title: string
    category?: string
    description?: string
  }
  /**
   * 该页面允许 Ezoic 广告（首页与技能详情页）。站点配置运行时加载器
   *（见 head 中的 sitecfg 脚本）按后台开关决定是否真正注入广告脚本，
   * 此 prop 只圈定「候选广告页」，不控制开关本身。
   */
  ezAds?: boolean
}

const { lang, title, description, path, ogType, noindex, i18n, cards, skill, ezAds } = Astro.props
const t = T[lang]

/*
 * canonical / og:url 必须是绝对 URL，否则搜索引擎无法正确判断页面归属与去重。
 * Astro.site 来自 astro.config.mjs 的 site（构建时由 SITE_URL 环境变量注入），
 * 缺失时回退到正式域名，避免构建产物里出现相对路径。
 */
const SITE_ORIGIN = Astro.site?.origin ?? 'https://skill.gautown.top'
const pathname = path ?? Astro.url.pathname
const canonical = new URL(pathname, SITE_ORIGIN).href
const pageTitle = title ? `${title} · ${t.siteName}` : t.siteName
const pageDesc = description ?? t.siteDesc
/*
 * 社交分享图（og.png）已下线：og:image / twitter:image 标签连同
 * 生成脚本 scripts/make-og-image.mjs 一并删除，社交平台分享为纯文字卡片。
 */
/**
 * 五语言 hreflang 集合。
 *
 * 全站五语言是同一批内容的五套 URL（zh 挂根，其余各占一个路径段），
 * 没有 hreflang 互指时搜索引擎无法判断哪套权威，存在互相稀释的风险。
 * 语言前缀已是结构化的（/zh-tw /en /ko /ms），因此无需每个页面再传
 * alternate —— 从 canonical 路径抹掉当前前缀，再为每种语言补上各自的
 * 前缀即可得到全套平级 URL。
 */
const strippedPath = stripBase(pathname, lang)
const altLinks = LOCALES.map(l => ({
  lang: LANG_META[l].htmlLang,
  href: new URL(`${LANG_META[l].base}${strippedPath}`, SITE_ORIGIN).href,
}))
/** x-default：请求的语言未提供时的兜底入口，指向默认语言（简中）版本 */
const xDefaultHref = altLinks.find(a => a.lang === LANG_META.zh.htmlLang)!.href
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      /*
       * localStorage 读取必须 try/catch：Safari 无痕模式、站点数据被禁用、
       * 或以 file:// 打开时，访问它会抛 SecurityError。
       * 不兜住的话这行抛错会中断整段内联脚本。
       * 读不到就走 CSS 的系统主题兜底，功能不受影响。
       */
      try {
        const __t = localStorage.getItem('hamster:theme')
        if (__t) document.documentElement.dataset.theme = __t
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      站点配置运行时加载器（全站页面，管理后台 /admin/ 写 KV、本脚本读 API）：
      - 站点参数（名称/描述/页脚备注）由它拉取 /api/site-config 覆盖
        [data-site-name] 等锚点；localStorage 镜像 5 分钟，多数页面零网络请求。
      - Ezoic 广告（ezAds 页面）也由配置驱动：总开关/Side Rails 方向/
        anchor/插屏决定是否注入官方脚本与 config 标志。
        脚本注入顺序保持官方要求 CMP → sa.min.js → 命令队列 → analytics，
        动态创建的 script 默认乱序执行，async=false 强制按序。
      - API 不可用/未配置时走内置基线：广告开、仅左侧 Side Rail、
        无 anchor/插屏——与后台从未配置时的站点现状一致。
    */}
    <script is:inline data-ads={ezAds ? '1' : '0'}>
      (function () {
        var KEY = 'hamster:sitecfg', TTL_MS = 300000
        var adsWanted = document.currentScript.getAttribute('data-ads') === '1'
        var cached = null
        try {
          var raw = localStorage.getItem(KEY)
          if (raw) {
            var c = JSON.parse(raw)
            if (c && typeof c._t === 'number' && Date.now() - c._t < TTL_MS) cached = c
          }
        } catch (e) {}
        if (adsWanted) injectAds(cached && cached.ads)
        fetch('/api/site-config').then(function (r) {
          return r.ok ? r.json() : null
        }).then(function (fresh) {
          if (!fresh || fresh.error) return
          fresh._t = Date.now()
          try { localStorage.setItem(KEY, JSON.stringify(fresh)) } catch (e) {}
          applyText(fresh.site)
        }).catch(function () {})

        function injectAds(ads) {
          if (ads && ads.enabled === false) return
          var side = (ads && ads.sideRails) || 'left'
          var flags = []
          if (side === 'off') flags.push('disableLeftSideRail:true', 'disableRightSideRail:true')
          else if (side === 'left') flags.push('disableRightSideRail:true')
          if (!ads || ads.vignette !== true) flags.push('disableInterstitial:true')
          var anchor = !!(ads && ads.anchor)
          var d = document
          function add(src) {
            var s = d.createElement('script')
            s.async = false
            s.setAttribute('data-cfasync', 'false')
            s.src = src
            d.head.appendChild(s)
          }
          add('https://cmp.gatekeeperconsent.com/min.js')
          add('https://the.gatekeeperconsent.com/cmp.min.js')
          add('//www.ezojs.com/ezoic/sa.min.js')
          var q = d.createElement('script')
          q.async = false
          q.textContent = 'window.ezstandalone=window.ezstandalone||{};ezstandalone.cmd=ezstandalone.cmd||[];'
            + 'ezstandalone.cmd.push(function(){ezstandalone.setEzoicAnchorAd(' + anchor + ');'
            + 'ezstandalone.config({' + flags.join(',') + '});ezstandalone.showAds()})'
          d.head.appendChild(q)
          add('//ezoicanalytics.com/analytics.js')
        }

        function applyText(site) {
          if (!site) return
          var slots = [
            ['name', '[data-site-name]'],
            ['desc', '[data-site-desc]'],
            ['footerNote', '[data-footer-note]'],
          ]
          for (var i = 0; i < slots.length; i++) {
            var key = slots[i][0]
            if (typeof site[key] !== 'string' || !site[key]) continue
            var els = document.querySelectorAll(slots[i][1])
            for (var j = 0; j < els.length; j++) els[j].textContent = site[key]
          }
        }
      })()
    </script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Inter 自托管字体预加载（48KB/档 latin 子集）：首屏正文与标题都用它，
      不预加载会经历一轮 fallback 交换抖动。crossorigin 是字体预加载的硬性要求
      （匿名模式请求，不匹配会导致二次下载）。
    -->
    <link rel="preload" href="/fonts/inter-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- canonical：告诉搜索引擎本页的唯一权威地址（站内中英同源时尤其重要） -->
    <link rel="canonical" href={canonical} />

    {/*
      hreflang：五套 URL 完整互指（含本页自指，Google 要求自指是合法输入），
      声明「这是同一内容的不同语言版本」。
      没有它，搜索引擎只能自行猜测哪套权威，互相稀释。
    */}
    {altLinks.map(a => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {LOCALES.filter(l => l !== lang).map(l => (
      <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />
    ))}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <title>{pageTitle}</title>
  </head>
  <body
    data-i18n={i18n}
    data-cards={cards}
  >
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    {/* 全站聊天窗：固定在视口右边缘、垂直居中 */}
    <ChatWidget lang={lang} skill={skill} />
  </body>
</html>