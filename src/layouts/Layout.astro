---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ChatWidget from '../components/ChatWidget.astro'
import { T, type Locale } from '../i18n/translations'
import { LANG_META, LOCALES, stripBase } from '../lib/languages'

interface Props {
  lang: Locale
  title?: string
  /** 页面描述；详情页传 skill 自身的描述 */
  description?: string
  /** 该页面的站点内路径（如 /skills/pdf），用于拼 canonical 与 og:url */
  path?: string
  /** og:type；详情页传 article 类语义，其余留空按 website */
  ogType?: string
  /**
   * 禁止索引。搜索结果页用：内容由 URL 参数决定，没有稳定内容可抓，
   * 参数页若被索引会造成大量重复内容。
   */
  noindex?: boolean
  /** 注入给客户端脚本的文案包（JSON 字符串） */
  i18n?: string
  /** 注入给客户端脚本的卡片渲染配置（JSON 字符串） */
  cards?: string
  /**
   * 当前页面的技能信息。仅技能详情页传入，
   * 聊天窗会把它作为上下文发给后端，让回答能结合这条技能展开。
   */
  skill?: {
    id: string
    title: string
    category?: string
    description?: string
  }
  /**
   * 开启 Ezoic 广告集成（JS Standalone 模式）。仅首页与技能详情页传 true：
   * 本站走 Cloudflare Workers 部署，不能改用 Ezoic 的 DNS 代理集成
   * （那会接管全部流量、绕过 Worker），JS 集成是官方给非 WordPress 站的标准路径。
   */
  ezAds?: boolean
}

const { lang, title, description, path, ogType, noindex, i18n, cards, skill, ezAds } = Astro.props
const t = T[lang]

/*
 * canonical / og:url 必须是绝对 URL，否则搜索引擎无法正确判断页面归属与去重。
 * Astro.site 来自 astro.config.mjs 的 site（构建时由 SITE_URL 环境变量注入），
 * 缺失时回退到正式域名，避免构建产物里出现相对路径。
 */
const SITE_ORIGIN = Astro.site?.origin ?? 'https://skill.gautown.top'
const pathname = path ?? Astro.url.pathname
const canonical = new URL(pathname, SITE_ORIGIN).href
const pageTitle = title ? `${title} · ${t.siteName}` : t.siteName
const pageDesc = description ?? t.siteDesc
/*
 * 社交分享图（og.png）已下线：og:image / twitter:image 标签连同
 * 生成脚本 scripts/make-og-image.mjs 一并删除，社交平台分享为纯文字卡片。
 */
/**
 * 五语言 hreflang 集合。
 *
 * 全站五语言是同一批内容的五套 URL（zh 挂根，其余各占一个路径段），
 * 没有 hreflang 互指时搜索引擎无法判断哪套权威，存在互相稀释的风险。
 * 语言前缀已是结构化的（/zh-tw /en /ko /ms），因此无需每个页面再传
 * alternate —— 从 canonical 路径抹掉当前前缀，再为每种语言补上各自的
 * 前缀即可得到全套平级 URL。
 */
const strippedPath = stripBase(pathname, lang)
const altLinks = LOCALES.map(l => ({
  lang: LANG_META[l].htmlLang,
  href: new URL(`${LANG_META[l].base}${strippedPath}`, SITE_ORIGIN).href,
}))
/** x-default：请求的语言未提供时的兜底入口，指向默认语言（简中）版本 */
const xDefaultHref = altLinks.find(a => a.lang === LANG_META.zh.htmlLang)!.href
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      /*
       * localStorage 读取必须 try/catch：Safari 无痕模式、站点数据被禁用、
       * 或以 file:// 打开时，访问它会抛 SecurityError。
       * 不兜住的话这行抛错会中断整段内联脚本。
       * 读不到就走 CSS 的系统主题兜底，功能不受影响。
       */
      try {
        const __t = localStorage.getItem('hamster:theme')
        if (__t) document.documentElement.dataset.theme = __t
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Ezoic 广告集成（JS Standalone，官方非 WordPress 路径）。加载顺序是硬要求：
      CMP 隐私脚本必须先于任何广告/统计代码；sa.min.js 为广告库本体（async），
      其后的内联脚本同步建好 ezstandalone 命令队列——async 脚本完成前队列必已就绪。
      Side Rails（宽屏两侧闲置边栏的竖幅）由 Ezoic 平台自动渲染，无站内占位符；
      无参 showAds() 只刷新自动格式，不产生正文内广告位。
      按产品要求只保留最左一条侧轨，右侧用 config 关闭（删掉该行即恢复双侧）。
    */}
    {ezAds && (
      <>
        <script is:inline data-cfasync="false" src="https://cmp.gatekeeperconsent.com/min.js"></script>
        <script is:inline data-cfasync="false" src="https://the.gatekeeperconsent.com/cmp.min.js"></script>
        <script is:inline async src="//www.ezojs.com/ezoic/sa.min.js"></script>
        <script is:inline>
          window.ezstandalone = window.ezstandalone || {}
          ezstandalone.cmd = ezstandalone.cmd || []
          ezstandalone.cmd.push(function () {
            ezstandalone.config({ disableRightSideRail: true })
            ezstandalone.showAds()
          })
        </script>
        <script is:inline src="//ezoicanalytics.com/analytics.js"></script>
      </>
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Inter 自托管字体预加载（48KB/档 latin 子集）：首屏正文与标题都用它，
      不预加载会经历一轮 fallback 交换抖动。crossorigin 是字体预加载的硬性要求
      （匿名模式请求，不匹配会导致二次下载）。
    -->
    <link rel="preload" href="/fonts/inter-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- canonical：告诉搜索引擎本页的唯一权威地址（站内中英同源时尤其重要） -->
    <link rel="canonical" href={canonical} />

    {/*
      hreflang：五套 URL 完整互指（含本页自指，Google 要求自指是合法输入），
      声明「这是同一内容的不同语言版本」。
      没有它，搜索引擎只能自行猜测哪套权威，互相稀释。
    */}
    {altLinks.map(a => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {LOCALES.filter(l => l !== lang).map(l => (
      <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />
    ))}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <title>{pageTitle}</title>
  </head>
  <body
    data-i18n={i18n}
    data-cards={cards}
  >
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    {/* 全站聊天窗：固定在视口右边缘、垂直居中 */}
    <ChatWidget lang={lang} skill={skill} />
  </body>
</html>