---
import type { CollectionEntry } from 'astro:content'
import { isPlaceholderBody, renderSkillMarkdown, renderSkillBodyForDisplay } from '../lib/markdown'
import { tagSlug } from '../lib/tags'
import CopyPrompt from './CopyPrompt.astro'
import GiscusComments from './GiscusComments.astro'
import { CATEGORY_NAMES, type CategoryKey } from '../lib/categories'
import { T, type Locale } from '../i18n/translations'

interface Props {
  locale: Locale
  entry: CollectionEntry<'skills'>
  skills: CollectionEntry<'skills'>[]
}

const { locale, entry, skills } = Astro.props
const d = entry.data as {
  title: string
  titleEn: string
  description: string
  descriptionEn: string
  category: CategoryKey
  tags: string[]
  github?: string
  prompt?: string
  author?: string
  bestFor?: string
  steps?: string[]
  example?: string
  evaluation?: string
  guide?: string
  grade?: 'S' | 'A' | 'B'
  score?: number
  likes?: number
  ratingUp?: number
  /** 来源仓库 star 数（自动发现阶段获取） */
  stars?: number
  files?: string[]
}
const t = T[locale]
const base = locale === 'en' ? '/en' : ''
const title = locale === 'en' ? d.titleEn : d.title
const desc = locale === 'en' ? d.descriptionEn : d.description
const catName = CATEGORY_NAMES[locale][d.category]
const sameCat = skills.filter(s => s.data.category === d.category && s.id !== entry.id)
const related = (sameCat.length > 0 ? sameCat : skills.filter(s => s.id !== entry.id)).slice(0, 3)
const md = renderSkillMarkdown
const skillMdHtml = md(entry.body)
const evaluationHtml = md(d.evaluation)
const guideHtml = md(d.guide)
const gradeLabel = d.grade ? (locale === 'zh' ? `${d.grade}${t.gradeSuffix}` : `Grade ${d.grade}`) : ''

/*
 * 正文显示用渲染：超长内容截断、HTML 规整。
 * 注意「导出/安装/复制」仍使用完整原文（见下方 skillMdText），不受此处影响。
 */
const bodyView = renderSkillBodyForDisplay(entry.body)
/** 正文是相对路径引用或占位符时，改用提示文案而不是渲染出无意义的路径 */
const bodyIsPlaceholder = isPlaceholderBody(entry.body)
/** tab 数量大于 1 才需要切换栏（加入「讨论」后始终成立，保留此值供调试查看） */
const tabCount = 1 + (evaluationHtml ? 1 : 0) + (guideHtml ? 1 : 0) + 1

const fileGroups: { folder: string | null; items: string[] }[] = []
for (const f of d.files ?? []) {
  const parts = f.split('/')
  const folder = parts.length > 1 ? parts.slice(0, -1).join('/') : null
  const name = parts[parts.length - 1]
  let g = fileGroups.find(x => x.folder === folder)
  if (!g) {
    g = { folder, items: [] }
    fileGroups.push(g)
  }
  g.items.push(name)
}

const skillMdText = [
  '---',
  `title: ${d.title}`,
  `description: ${d.description}`,
  `category: ${d.category}`,
  `tags: [${d.tags.join(', ')}]`,
  '---',
  '',
  (entry.body ?? '').trim(),
  '',
  d.prompt ? `## Prompt\n\n${d.prompt.trim()}` : '',
]
  .join('\n')
  .trim()
---

<article class="container detail">
  <a class="crumb" href={base || '/'}>&larr; {t.backAll}</a>
  <div class="detail-grid">
    <div class="detail-main">
      <p class="eyebrow">{t.catsEyebrow}</p>
      <h1>{title}</h1>
      <div class="meta-row">
        <span class="badge">{catName}</span>
        {d.author && <span class="meta-item">by <strong>@{d.author}</strong></span>}
        {d.tags.length > 0 && <span class="meta-item">{d.tags.length} {t.tagsLabel}</span>}
      </div>
      <p class="desc">{desc}</p>

      <div class="tabs">
        {/*
          切换栏在有多个 tab 时才渲染。
          加入「讨论」tab 后，站内所有详情页都至少有两个 tab（SKILL.md + 讨论），
          因此切换栏会始终存在——这与此前「单 tab 不渲染切换栏」的取舍不同，
          但两个 tab 属于正常的分栏 UI，不是噪音。
          evaluation / guide 仅本地精选 skill 有（实测远端 8797 条命中数为 0）。
        */}
        <div class="tab-bar" role="tablist">
          <button class="tab active" type="button" data-tab="skillmd">SKILL.md</button>
          {evaluationHtml && <button class="tab" type="button" data-tab="evaluation">{t.tabEvaluation}</button>}
          {guideHtml && <button class="tab" type="button" data-tab="guide">{t.tabGuide}</button>}
          <button class="tab" type="button" data-tab="discussion">{t.tabDiscussion}</button>
        </div>
        <div class="tab-panel" data-tab="skillmd" role="tabpanel">
          {bodyIsPlaceholder ? (
            <p class="tab-empty">{t.bodyPlaceholder}</p>
          ) : bodyView.html ? (
            <div class="tab-content" set:html={bodyView.html} />
          ) : (
            <p class="tab-empty">{t.tabEmpty}</p>
          )}
          {bodyView.truncated && (
            <p class="tab-truncated">
              {locale === 'en'
                ? `This document is very long (${bodyView.fullLength.toLocaleString()} characters); only the first part is shown.`
                : `本文档较长（${bodyView.fullLength.toLocaleString()} 字符），此处仅展示前一部分。`}
              {d.github && (
                <a href={d.github} target="_blank" rel="noopener">
                  {locale === 'en' ? ' View the full version on GitHub ↗' : ' 在 GitHub 查看完整内容 ↗'}
                </a>
              )}
            </p>
          )}
        </div>
        {evaluationHtml && (
          <div class="tab-panel" data-tab="evaluation" role="tabpanel" hidden>
            <div class="tab-content" set:html={evaluationHtml} />
          </div>
        )}
        {guideHtml && (
          <div class="tab-panel" data-tab="guide" role="tabpanel" hidden>
            <div class="tab-content" set:html={guideHtml} />
          </div>
        )}
        <div class="tab-panel" data-tab="discussion" role="tabpanel" hidden>
          <div class="tab-content discussion-panel">
            <GiscusComments term={entry.id} locale={locale} />
          </div>
        </div>
      </div>

      {d.steps && d.steps.length > 0 && (
        <div class="detail-section">
          <p class="sec-label">{t.stepsLabel}</p>
          <ol class="steps">
            {d.steps.map((step, i) => (
              <li class="step">
                <span class="step-num">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      {d.bestFor && (
        <div class="detail-section">
          <p class="sec-label">{t.bestForLabel}</p>
          <p class="bestfor">{d.bestFor}</p>
        </div>
      )}

      {d.prompt && (
        <CopyPrompt prompt={d.prompt} label={t.copyPrompt} copyLabel={t.copy} copied={t.copied} note={t.promptNote} />
      )}

      {d.example && (
        <div class="detail-section">
          <p class="sec-label">{t.exampleLabel}</p>
          <div class="example-terminal">
            <div class="example-titlebar">
              <span class="dot dot-r"></span>
              <span class="dot dot-y"></span>
              <span class="dot dot-g"></span>
              <span class="example-file">output.md</span>
            </div>
            <pre>{d.example}</pre>
          </div>
        </div>
      )}
    </div>
    <aside class="detail-side">
      {/*
        数据区块：评分 / 点赞 / 投票 / 仓库热度。
        实测 8797 条远端 skill 里评分、点赞、投票三条数据全部 0 命中，
        原先它们各自渲染成独立区块，页面上就是三个空壳。
        现在合并为一个区块，并在没有任何数据时整体不渲染。
        stars 在 100% 条目上都有值（复用主题发现阶段的结果，零额外请求）。
      */}
      {(() => {
        const hasScore = Boolean(d.grade) || d.score != null
        const hasLike = d.likes != null
        const hasVote = d.ratingUp != null
        const hasStars = typeof d.stars === 'number'
        if (!hasScore && !hasLike && !hasVote && !hasStars) return null
        const stars = d.stars ?? 0
        return (
          <div class="side-block">
            {hasStars && (
              <div class="stars-row">
                <span class="stars-icon">★</span>
                <span class="stars-num">{stars.toLocaleString()}</span>
                <span class="stars-label">{locale === 'en' ? 'repo stars' : '仓库热度'}</span>
              </div>
            )}
            {(hasScore || hasLike) && (
              <div class="score-row">
                {d.grade && <span class="grade-badge">{gradeLabel}</span>}
                {d.score != null && (
                  <div class="score-block">
                    <div class="score-num">{d.score}</div>
                    <div class="score-label">{t.aiScore}</div>
                  </div>
                )}
                {hasLike && (
                  <button class="like-btn" type="button" data-seed={d.likes ?? 0}>
                    <span class="heart">♡</span>
                    <span class="like-count">{d.likes ?? 0}</span>
                  </button>
                )}
              </div>
            )}
            {hasVote && (
              <div class="rating-row">
                <button class="vote-btn up" type="button" data-seed={d.ratingUp ?? 0}>
                  <span class="up-count">{d.ratingUp ?? 0}</span> {t.voteUp}
                </button>
                <span class="rating-sep">|</span>
                <button class="vote-btn down" type="button">
                  <span class="down-count">0</span> {t.voteDown}
                </button>
              </div>
            )}
          </div>
        )
      })()}
      <div class="side-block">
        <div class="btn-row">
          {/*
            「一键复制」只在有独立 prompt 文案时才有意义，而远端 skill 全部没有
            prompt 字段——原先它不渲染、导出按钮却照常显示，按钮组因此只剩一个。
            这里让导出按钮在无 prompt 时占满整行，视觉上不留空位。
          */}
          {d.prompt ? (
            <>
              <button class="copy-btn side-btn2" type="button" data-label={t.copy} data-copied={t.copied}>
                <span class="btn-eyebrow">{t.oneClick}</span>
                <span class="btn-main">{t.copy}</span>
              </button>
              <button class="export-btn side-btn2" type="button">
                <span class="btn-eyebrow">.MD</span>
                <span class="btn-main">{t.exportBtn}</span>
              </button>
            </>
          ) : (
            <button class="export-btn side-btn2 full" type="button">
              <span class="btn-eyebrow">.MD</span>
              <span class="btn-main">{t.exportBtn}</span>
            </button>
          )}
        </div>
        <button class="install-btn" type="button" data-label={t.installBtn} data-copied={t.copied}>
          &gt;_ {t.installBtn}
        </button>
        {d.github && (
          <a class="github-cta" href={d.github} target="_blank" rel="noopener">▶ {t.githubLabel} ↗</a>
        )}
      </div>
      {d.files && d.files.length > 0 && (
        <div class="side-block">
          <p class="side-label">{t.fileBrowse} <span class="file-total">{d.files.length}</span></p>
          <div class="file-box">
            {fileGroups.map(g => (
              <div>
                {g.folder && <div class="file-folder">{g.folder}/</div>}
                {g.items.map(n => <div class={g.folder ? 'file-item nested' : 'file-item'}>{n}</div>)}
              </div>
            ))}
          </div>
        </div>
      )}
      <div class="side-block">
        <p class="side-label">{t.sideCategory}</p>
        <div class="side-cat">{catName}</div>
        <a class="cat-link" href={`${base}/categories/${d.category}`}>{t.backCategory} →</a>
      </div>
      {related.length > 0 && (
        <div class="side-block">
          <p class="side-label">{t.relatedLabel}</p>
          <div class="related-list">
            {related.map(r => (
              <a class="related-item" href={`${base}/skills/${r.id}`}>
                <span class="related-name">{locale === 'en' ? r.data.titleEn : r.data.title}</span>
                <span class="related-cat">{CATEGORY_NAMES[locale][r.data.category as CategoryKey]}</span>
              </a>
            ))}
          </div>
        </div>
      )}
      {d.tags.length > 0 && (
        <div class="side-block">
          <p class="side-label">{t.tagsLabel}</p>
          <div class="tags">{d.tags.map(tag => <a class="tag tag-link" href={`${base}/tags/${tagSlug(tag)}`}>{tag}</a>)}</div>
        </div>
      )}
    </aside>
  </div>
</article>

<script
  type="application/json"
  id="skill-md-text"
  is:inline
  set:html={JSON.stringify(skillMdText).replace(/</g, '\\u003c')}
></script>

<script>
  const tabBtns = document.querySelectorAll<HTMLElement>('.tab')
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel')
  /** 切到「讨论」tab 时才注入 Giscus 脚本：站内 17860 个详情页不能每页都预加载 */
  function activateTab(btn: HTMLElement) {
    tabBtns.forEach(b => b.classList.toggle('active', b === btn))
    panels.forEach(p => {
      p.hidden = p.dataset.tab !== btn.dataset.tab
    })
    if (btn.dataset.tab === 'discussion') {
      const host = document.querySelector<HTMLElement>('.giscus-host')
      const mount = (window as unknown as { mountGiscus?: (el: HTMLElement) => void }).mountGiscus
      if (host && mount) mount(host)
    }
  }
  tabBtns.forEach(btn => btn.addEventListener('click', () => activateTab(btn)))

  // 支持 #discussion 深链：从站外直接打开讨论 tab
  if (location.hash === '#discussion') {
    const discussionBtn = document.querySelector<HTMLElement>('.tab[data-tab="discussion"]')
    if (discussionBtn) activateTab(discussionBtn)
  }

  const mdEl = document.getElementById('skill-md-text')
  let mdText = ''
  try {
    mdText = mdEl ? JSON.parse(mdEl.textContent || '""') : ''
  } catch {
    mdText = ''
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text)
    } catch {
      const ta = document.createElement('textarea')
      ta.value = text
      document.body.appendChild(ta)
      ta.select()
      document.execCommand('copy')
      ta.remove()
    }
  }

  const installBtn = document.querySelector<HTMLElement>('.install-btn')
  installBtn?.addEventListener('click', async () => {
    await copyText(mdText)
    installBtn.textContent = installBtn.dataset.copied || 'Copied'
    setTimeout(() => {
      installBtn.textContent = installBtn.dataset.label || ''
    }, 1600)
  })

  document.querySelector('.export-btn')?.addEventListener('click', () => {
    const blob = new Blob([mdText], { type: 'text/markdown' })
    const a = document.createElement('a')
    a.href = URL.createObjectURL(blob)
    a.download = 'SKILL.md'
    a.click()
    URL.revokeObjectURL(a.href)
  })

  const likeBtn = document.querySelector<HTMLElement>('.like-btn')
  if (likeBtn) {
    const key = 'hamster:like:' + location.pathname
    const seed = Number(likeBtn.dataset.seed || 0)
    const countEl = likeBtn.querySelector('.like-count')
    const heartEl = likeBtn.querySelector('.heart')
    let liked = localStorage.getItem(key) === '1'
    const paintLike = () => {
      if (countEl) countEl.textContent = String(seed + (liked ? 1 : 0))
      if (heartEl) heartEl.textContent = liked ? '♥' : '♡'
      likeBtn.classList.toggle('liked', liked)
    }
    likeBtn.addEventListener('click', () => {
      liked = !liked
      localStorage.setItem(key, liked ? '1' : '0')
      paintLike()
    })
    paintLike()
  }

  const upBtn = document.querySelector<HTMLElement>('.vote-btn.up')
  const downBtn = document.querySelector<HTMLElement>('.vote-btn.down')
  if (upBtn && downBtn) {
    const key = 'hamster:vote:' + location.pathname
    const upSeed = Number(upBtn.dataset.seed || 0)
    let vote = localStorage.getItem(key) || ''
    const paintVote = () => {
      const upCount = upBtn.querySelector('.up-count')
      const downCount = downBtn.querySelector('.down-count')
      if (upCount) upCount.textContent = String(upSeed + (vote === 'up' ? 1 : 0))
      if (downCount) downCount.textContent = String(vote === 'down' ? 1 : 0)
      upBtn.classList.toggle('voted', vote === 'up')
      downBtn.classList.toggle('voted', vote === 'down')
    }
    upBtn.addEventListener('click', () => {
      vote = vote === 'up' ? '' : 'up'
      vote ? localStorage.setItem(key, vote) : localStorage.removeItem(key)
      paintVote()
    })
    downBtn.addEventListener('click', () => {
      vote = vote === 'down' ? '' : 'down'
      vote ? localStorage.setItem(key, vote) : localStorage.removeItem(key)
      paintVote()
    })
    paintVote()
  }
</script>
