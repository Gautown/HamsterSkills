---
import type { CollectionEntry } from 'astro:content'
import { isPlaceholderBody, renderSkillMarkdown, renderSkillBodyForDisplay } from '../lib/markdown'
import { tagSlug } from '../lib/tags'
import CopyPrompt from './CopyPrompt.astro'
import GiscusComments from './GiscusComments.astro'
import { CATEGORY_NAMES, type CategoryKey } from '../lib/categories'
import { T, fillPlaceholders, type Locale } from '../i18n/translations'
import { baseOf } from '../lib/site-paths'
import { usesZhContent } from '../lib/languages'
import { buildInstallCommand, installSourceOf } from '../lib/install'

interface Props {
  locale: Locale
  entry: CollectionEntry<'skills'>
  skills: CollectionEntry<'skills'>[]
}

const { locale, entry, skills } = Astro.props
const d = entry.data as {
  title: string
  titleEn: string
  description: string
  descriptionEn: string
  category: CategoryKey
  tags: string[]
  github?: string
  prompt?: string
  author?: string
  bestFor?: string
  steps?: string[]
  example?: string
  evaluation?: string
  guide?: string
  grade?: 'S' | 'A' | 'B'
  score?: number
  likes?: number
  ratingUp?: number
  /** 来源仓库 star 数（自动发现阶段获取） */
  stars?: number
  files?: string[]
}
const t = T[locale]
const base = baseOf(locale)
const title = usesZhContent(locale) ? d.title : d.titleEn
const desc = usesZhContent(locale) ? d.description : d.descriptionEn
const catName = CATEGORY_NAMES[locale][d.category]
const sameCat = skills.filter(s => s.data.category === d.category && s.id !== entry.id)
const related = (sameCat.length > 0 ? sameCat : skills.filter(s => s.id !== entry.id)).slice(0, 3)
const md = renderSkillMarkdown
const evaluationHtml = md(d.evaluation)
const guideHtml = md(d.guide)
const gradeLabel = d.grade
  ? locale === 'zh' || locale === 'zh-tw'
    ? `${d.grade}${t.gradeSuffix}`
    : `Grade ${d.grade}`
  : ''

/*
 * 正文显示用渲染：超长内容截断、HTML 规整。
 * 注意「导出/安装/复制」仍使用完整原文（见下方 skillMdText），不受此处影响。
 */
const bodyView = renderSkillBodyForDisplay(entry.body)
/** 正文是相对路径引用或占位符时，改用提示文案而不是渲染出无意义的路径 */
const bodyIsPlaceholder = isPlaceholderBody(entry.body)

/*
 * 安装菜单（详见 docs/install-to-agents.md）。
 *
 * 安装源：远端技能 → 源仓库 tree URL（`npx skills add` 直接吃这种格式）；
 * 本地技能 → 本站 /dl/<id>.md（构建期生成的规范 SKILL.md 下载通道）。
 * 每行给两条命令（全局 -g / 项目），点击复制到剪贴板直接跑。
 * agent 取值必须与 skills CLI 官方表一致（docs/agents.md），改动前先核对。
 */
const installSource = installSourceOf({
  github: d.github,
  id: entry.id,
  origin: Astro.site?.origin,
})
const installTools: Array<{ label: string; agent?: string }> = [
  { label: 'OpenCode', agent: 'opencode' },
  { label: 'Claude Code', agent: 'claude-code' },
  { label: 'Codex', agent: 'codex' },
  { label: 'Cursor', agent: 'cursor' },
  { label: 'VS Code · Copilot', agent: 'github-copilot' },
  { label: 'Hermes Agent', agent: 'hermes-agent' },
  { label: t.installGeneric },
]
const installRows = installSource
  ? installTools.map(tool => ({
      label: tool.label,
      globalCmd: buildInstallCommand({ source: installSource, agent: tool.agent, global: true }),
      projectCmd: buildInstallCommand({ source: installSource, agent: tool.agent, global: false }),
    }))
  : []
/** WorkBuddy 无 CLI 通道：给可复制的手动安装指引（目录为社区实测，见 docs） */
const workbuddyHint = fillPlaceholders(t.workbuddyHint, { name: entry.id })

const fileGroups: { folder: string | null; items: string[] }[] = []
for (const f of d.files ?? []) {
  const parts = f.split('/')
  const folder = parts.length > 1 ? parts.slice(0, -1).join('/') : null
  const name = parts[parts.length - 1]
  let g = fileGroups.find(x => x.folder === folder)
  if (!g) {
    g = { folder, items: [] }
    fileGroups.push(g)
  }
  g.items.push(name)
}

const skillMdText = [
  '---',
  `title: ${d.title}`,
  `description: ${d.description}`,
  `category: ${d.category}`,
  `tags: [${d.tags.join(', ')}]`,
  '---',
  '',
  (entry.body ?? '').trim(),
  '',
  d.prompt ? `## Prompt\n\n${d.prompt.trim()}` : '',
]
  .join('\n')
  .trim()
---

<article class="container detail">
  <a class="crumb" href={base || '/'}>&larr; {t.backAll}</a>
  <div class="detail-grid">
    <div class="detail-main">
      <p class="eyebrow">{t.catsEyebrow}</p>
      <h1>{title}</h1>
      <div class="meta-row">
        <span class="badge">{catName}</span>
        {d.author && <span class="meta-item">by <strong>@{d.author}</strong></span>}
        {d.tags.length > 0 && <span class="meta-item">{d.tags.length} {t.tagsLabel}</span>}
      </div>
      <p class="desc">{desc}</p>

      <div class="tabs">
        {/*
          切换栏在有多个 tab 时才渲染。
          加入「讨论」tab 后，站内所有详情页都至少有两个 tab（SKILL.md + 讨论），
          因此切换栏会始终存在——这与此前「单 tab 不渲染切换栏」的取舍不同，
          但两个 tab 属于正常的分栏 UI，不是噪音。
          evaluation / guide 仅本地精选 skill 有（实测远端 8797 条命中数为 0）。
        */}
        <div class="tab-bar" role="tablist" aria-label={t.tabListLabel}>
          {/*
            WAI-ARIA 标签页模式要求成套属性：
            按钮要 role="tab" + aria-selected + aria-controls 指向面板 id，
            面板要有 id + aria-labelledby 指回按钮。
            此前只有 tablist 与 tabpanel，按钮被读屏当普通按钮播报，
            选中哪个面板也无从得知。方向键切换同样缺失。
          */}
          <button
            class="tab active"
            type="button"
            role="tab"
            id="tab-btn-skillmd"
            aria-controls="tab-panel-skillmd"
            aria-selected="true"
            data-tab="skillmd"
          >SKILL.md</button>
          {evaluationHtml && (
            <button
              class="tab"
              type="button"
              role="tab"
              id="tab-btn-evaluation"
              aria-controls="tab-panel-evaluation"
              aria-selected="false"
              tabindex="-1"
              data-tab="evaluation"
            >{t.tabEvaluation}</button>
          )}
          {guideHtml && (
            <button
              class="tab"
              type="button"
              role="tab"
              id="tab-btn-guide"
              aria-controls="tab-panel-guide"
              aria-selected="false"
              tabindex="-1"
              data-tab="guide"
            >{t.tabGuide}</button>
          )}
          <button
            class="tab"
            type="button"
            role="tab"
            id="tab-btn-discussion"
            aria-controls="tab-panel-discussion"
            aria-selected="false"
            tabindex="-1"
            data-tab="discussion"
          >{t.tabDiscussion}</button>
        </div>
        <div
          class="tab-panel"
          data-tab="skillmd"
          role="tabpanel"
          id="tab-panel-skillmd"
          aria-labelledby="tab-btn-skillmd"
          tabindex="0"
        >
          {bodyIsPlaceholder ? (
            <p class="tab-empty">{t.bodyPlaceholder}</p>
          ) : bodyView.html ? (
            <div class="tab-content" set:html={bodyView.html} />
          ) : (
            <p class="tab-empty">{t.tabEmpty}</p>
          )}
          {bodyView.truncated && (
            <p class="tab-truncated">
              {usesZhContent(locale)
                ? `本文档较长（${bodyView.fullLength.toLocaleString()} 字符），此处仅展示前一部分。`
                : `This document is very long (${bodyView.fullLength.toLocaleString()} characters); only the first part is shown.`}
              {d.github && (
                <a href={d.github} target="_blank" rel="noopener">
                  {usesZhContent(locale) ? ' 在 GitHub 查看完整内容 ↗' : ' View the full version on GitHub ↗'}
                </a>
              )}
            </p>
          )}
        </div>
        {evaluationHtml && (
          <div
            class="tab-panel"
            data-tab="evaluation"
            role="tabpanel"
            id="tab-panel-evaluation"
            aria-labelledby="tab-btn-evaluation"
            tabindex="0"
            hidden
          >
            <div class="tab-content" set:html={evaluationHtml} />
          </div>
        )}
        {guideHtml && (
          <div
            class="tab-panel"
            data-tab="guide"
            role="tabpanel"
            id="tab-panel-guide"
            aria-labelledby="tab-btn-guide"
            tabindex="0"
            hidden
          >
            <div class="tab-content" set:html={guideHtml} />
          </div>
        )}
        <div
          class="tab-panel"
          data-tab="discussion"
          role="tabpanel"
          id="tab-panel-discussion"
          aria-labelledby="tab-btn-discussion"
          tabindex="0"
          hidden
        >
          <div class="tab-content discussion-panel">
            <GiscusComments term={entry.id} locale={locale} />
          </div>
        </div>
      </div>

      {d.steps && d.steps.length > 0 && (
        <div class="detail-section">
          <p class="sec-label">{t.stepsLabel}</p>
          <ol class="steps">
            {d.steps.map((step, i) => (
              <li class="step">
                <span class="step-num">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      {d.bestFor && (
        <div class="detail-section">
          <p class="sec-label">{t.bestForLabel}</p>
          <p class="bestfor">{d.bestFor}</p>
        </div>
      )}

      {d.prompt && (
        <CopyPrompt prompt={d.prompt} label={t.copyPrompt} copyLabel={t.copy} copied={t.copied} failed={t.copyFailed} note={t.promptNote} />
      )}

      {d.example && (
        <div class="detail-section">
          <p class="sec-label">{t.exampleLabel}</p>
          <div class="example-terminal">
            <div class="example-titlebar">
              <span class="dot dot-r"></span>
              <span class="dot dot-y"></span>
              <span class="dot dot-g"></span>
              <span class="example-file">output.md</span>
            </div>
            <pre>{d.example}</pre>
          </div>
        </div>
      )}
    </div>
    <aside class="detail-side">
      {/*
        数据区块：评分 / 点赞 / 投票 / 仓库热度。
        实测 8797 条远端 skill 里评分、点赞、投票三条数据全部 0 命中，
        原先它们各自渲染成独立区块，页面上就是三个空壳。
        现在合并为一个区块，并在没有任何数据时整体不渲染。
        stars 在 100% 条目上都有值（复用主题发现阶段的结果，零额外请求）。
      */}
      {(() => {
        const hasScore = Boolean(d.grade) || d.score != null
        const hasLike = d.likes != null
        const hasVote = d.ratingUp != null
        const hasStars = typeof d.stars === 'number'
        if (!hasScore && !hasLike && !hasVote && !hasStars) return null
        const stars = d.stars ?? 0
        return (
          <div class="side-block">
            {hasStars && (
              <div class="stars-row">
                <span class="stars-icon">★</span>
                <span class="stars-num">{stars.toLocaleString()}</span>
                <span class="stars-label">{usesZhContent(locale) ? '仓库热度' : 'repo stars'}</span>
              </div>
            )}
            {(hasScore || hasLike) && (
              <div class="score-row">
                {d.grade && <span class="grade-badge">{gradeLabel}</span>}
                {d.score != null && (
                  <div class="score-block">
                    <div class="score-num">{d.score}</div>
                    <div class="score-label">{t.aiScore}</div>
                  </div>
                )}
                {hasLike && (
                  <button class="like-btn" type="button" data-seed={d.likes ?? 0}>
                    <span class="heart">♡</span>
                    <span class="like-count">{d.likes ?? 0}</span>
                  </button>
                )}
              </div>
            )}
            {hasVote && (
              <div class="rating-row">
                <button class="vote-btn up" type="button" data-seed={d.ratingUp ?? 0}>
                  <span class="up-count">{d.ratingUp ?? 0}</span> {t.voteUp}
                </button>
                <span class="rating-sep">|</span>
                <button class="vote-btn down" type="button">
                  <span class="down-count">0</span> {t.voteDown}
                </button>
              </div>
            )}
          </div>
        )
      })()}
      <div class="side-block">
        <div class="btn-row">
          {/*
            文件操作对：复制 + 导出。
            - 有 prompt（本地精选技能）：复制 = 复制 prompt（沿用 CopyPrompt 的
              全局 .copy-btn 绑定，复制的是 prompt 框内容）
            - 无 prompt（远端技能）：复制 = 复制 SKILL.md 全文（.copy-skill-btn，
              由本组件脚本处理；不能复用 .copy-btn —— 那个选择器被 CopyPrompt
              脚本全局接管，会去复制并不存在的 prompt 框）
          */}
          {d.prompt ? (
            <button class="copy-btn side-btn2" type="button" data-label={t.copy} data-copied={t.copied}>
              <span class="btn-eyebrow">{t.oneClick}</span>
              <span class="btn-main">{t.copy}</span>
            </button>
          ) : (
            <button class="copy-skill-btn side-btn2" type="button" data-label={t.copy} data-copied={t.copied} data-failed={t.copyFailed}>
              <span class="btn-eyebrow">{t.oneClick}</span>
              <span class="btn-main">{t.copy}</span>
            </button>
          )}
          <button class="export-btn side-btn2" type="button">
            <span class="btn-eyebrow">.MD</span>
            <span class="btn-main">{t.exportBtn}</span>
            <span class="export-status export-status-inline" data-done={t.exported} aria-live="polite"></span>
          </button>
        </div>
        {/*
          安装菜单：安装按钮改作 <details> 的 summary，展开工具列表。
          面板复用 .nav-drop 交互（Header 脚本的全局绑定：互斥开合 / 点外关闭 / Esc）。
          每行两条命令 chip [全局/项目]，点击复制到剪贴板，粘进终端直接跑；
          WorkBuddy 无 CLI 通道，给可复制的手动指引。
        */}
        {installRows.length > 0 && (
          <details class="nav-drop install-drop">
            <summary class="install-btn" aria-label={t.installMenuTitle}>
              <span class="install-btn-icon" aria-hidden="true">&gt;_</span>
              <span class="install-btn-text">{t.installBtn}</span>
              <svg class="install-caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="nav-drop-menu install-menu">
              <p class="install-menu-title">{t.installMenuTitle}</p>
              {installRows.map(row => (
                <div class="install-row">
                  <span class="install-tool">{row.label}</span>
                  <span class="install-chips">
                    <button class="cmd-chip" type="button" data-cmd={row.globalCmd} data-label={t.installGlobal} title={row.globalCmd}>{t.installGlobal}</button>
                    <button class="cmd-chip" type="button" data-cmd={row.projectCmd} data-label={t.installProject} title={row.projectCmd}>{t.installProject}</button>
                  </span>
                </div>
              ))}
              <div class="install-row">
                <span class="install-tool">WorkBuddy</span>
                <span class="install-chips">
                  <button class="cmd-chip" type="button" data-cmd={workbuddyHint} data-label={t.copy} title={workbuddyHint}>{t.copy}</button>
                </span>
              </div>
              <p class="install-hint">{t.installHint}</p>
            </div>
          </details>
        )}
        {d.github && (
          <a class="github-cta" href={d.github} target="_blank" rel="noopener">▶ {t.githubLabel} ↗</a>
        )}
      </div>
      {d.files && d.files.length > 0 && (
        <div class="side-block">
          <p class="side-label">{t.fileBrowse} <span class="file-total">{d.files.length}</span></p>
          <div class="file-box">
            {fileGroups.map(g => (
              <div>
                {g.folder && <div class="file-folder">{g.folder}/</div>}
                {g.items.map(n => <div class={g.folder ? 'file-item nested' : 'file-item'}>{n}</div>)}
              </div>
            ))}
          </div>
        </div>
      )}
      <div class="side-block">
        <p class="side-label">{t.sideCategory}</p>
        <div class="side-cat">{catName}</div>
        <a class="cat-link" href={`${base}/categories/${d.category}`}>{t.backCategory} →</a>
      </div>
      {related.length > 0 && (
        <div class="side-block">
          <p class="side-label">{t.relatedLabel}</p>
          <div class="related-list">
            {related.map(r => (
              <a class="related-item" href={`${base}/skills/${r.id}`}>
                <span class="related-name">{usesZhContent(locale) ? r.data.title : r.data.titleEn}</span>
                <span class="related-cat">{CATEGORY_NAMES[locale][r.data.category as CategoryKey]}</span>
              </a>
            ))}
          </div>
        </div>
      )}
      {d.tags.length > 0 && (
        <div class="side-block">
          <p class="side-label">{t.tagsLabel}</p>
          <div class="tags">{d.tags.map(tag => <a class="tag tag-link" href={`${base}/tags/${tagSlug(tag)}`}>{tag}</a>)}</div>
        </div>
      )}
    </aside>
  </div>
</article>

<script
  type="application/json"
  id="skill-md-text"
  is:inline
  set:html={JSON.stringify(skillMdText).replace(/</g, '\\u003c')}
></script>

<script>
  const tabBtns = Array.from(document.querySelectorAll<HTMLElement>('.tab[role="tab"]'))
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel')
  /** 切到「讨论」tab 时才注入 Giscus 脚本：站内 17860 个详情页不能每页都预加载 */
  function activateTab(btn: HTMLElement, focus = false) {
    tabBtns.forEach(b => {
      const on = b === btn
      b.classList.toggle('active', on)
      // aria-selected 与 tabindex 必须同步更新：
      // 读屏靠它播报当前面板，Tab 键靠它决定停在哪一个标签上
      b.setAttribute('aria-selected', on ? 'true' : 'false')
      b.tabIndex = on ? 0 : -1
    })
    panels.forEach(p => {
      p.hidden = p.dataset.tab !== btn.dataset.tab
    })
    if (focus) btn.focus()
    if (btn.dataset.tab === 'discussion') {
      const host = document.querySelector<HTMLElement>('.giscus-host')
      const mount = (window as unknown as { mountGiscus?: (el: HTMLElement) => void }).mountGiscus
      if (host && mount) mount(host)
    }
  }
  tabBtns.forEach(btn => btn.addEventListener('click', () => activateTab(btn)))

  /*
   * 方向键在标签间移动（WAI-ARIA 标签页模式的标准行为）。
   *
   * 只有 tabBtns.length > 1 才需要绑：单标签时方向键应当正常滚动页面，
   * 拦下来反而妨碍用户。
   */
  if (tabBtns.length > 1) {
    const tabBar = document.querySelector<HTMLElement>('.tab-bar')
    tabBar?.addEventListener('keydown', (e: KeyboardEvent) => {
      const cur = tabBtns.indexOf(document.activeElement as HTMLElement)
      if (cur < 0) return
      // Home / End 跳首尾，←→ 循环移动（两端不回绕到空白）
      const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
      let next = cur
      if (delta !== 0) next = (cur + delta + tabBtns.length) % tabBtns.length
      else if (e.key === 'Home') next = 0
      else if (e.key === 'End') next = tabBtns.length - 1
      else return
      e.preventDefault()
      activateTab(tabBtns[next], true)
    })
  }

  // 支持 #discussion 深链：从站外直接打开讨论 tab
  if (location.hash === '#discussion') {
    const discussionBtn = document.querySelector<HTMLElement>('.tab[data-tab="discussion"]')
    if (discussionBtn) activateTab(discussionBtn)
  }

  const mdEl = document.getElementById('skill-md-text')
  let mdText = ''
  try {
    mdText = mdEl ? JSON.parse(mdEl.textContent || '""') : ''
  } catch {
    mdText = ''
  }

  /**
   * 复制文本，返回**是否成功**。
   *
   * 原先没有返回值，调用方无法区分成功与失败，于是失败时照样显示
   * 「已复制」—— 谎报成功比直接不显示更糟：用户会以为已经拿到，
   * 然后去别处粘贴、发现是空的。
   */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch {
      /*
       * 降级路径用已废弃的 execCommand。
       * 它同样返回布尔值：失败时是 false，必须检查 ——
       * 不检查就等于把「复制失败」吞掉。
       */
      const ta = document.createElement('textarea')
      ta.value = text
      ta.setAttribute('readonly', '')
      ta.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0'
      document.body.appendChild(ta)
      ta.select()
      let ok = false
      try {
        ok = document.execCommand('copy')
      } catch {
        ok = false
      }
      ta.remove()
      return ok
    }
  }

  /*
   * 复制 SKILL.md 全文（.copy-skill-btn，远端技能、无 prompt 时显示）。
   * 本地技能走 .copy-btn —— 那个选择器被 CopyPrompt 的脚本全局接管、
   * 复制的是 prompt 框内容，两套职责不能混在一个选择器上。
   * 只替换 .btn-main 的文字节点，图标（.btn-eyebrow）不动。
   */
  const copySkillBtn = document.querySelector<HTMLElement>('.copy-skill-btn')
  copySkillBtn?.addEventListener('click', async () => {
    const ok = await copyText(mdText)
    const main = copySkillBtn.querySelector<HTMLElement>('.btn-main')
    const original = copySkillBtn.dataset.label ?? (main?.textContent ?? '')
    if (main) main.textContent = ok ? (copySkillBtn.dataset.copied || 'Copied') : (copySkillBtn.dataset.failed || 'Failed')
    copySkillBtn.classList.toggle('is-failed', !ok)
    setTimeout(() => {
      if (main) main.textContent = original
      copySkillBtn.classList.remove('is-failed')
    }, ok ? 1600 : 3200)
  })

  /*
   * 安装菜单命令 chip（.cmd-chip）：复制命令并闪符号反馈。
   * chip 太小放不下整句状态文案，成功显示 ✓、失败显示 ✗ + 红色标记，
   * 几秒后恢复为 data-label（「全局 / 项目 / 复制」等原文）。
   */
  const cmdChips = Array.from(document.querySelectorAll<HTMLElement>('.cmd-chip'))
  for (const chip of cmdChips) {
    chip.addEventListener('click', async () => {
      const ok = await copyText(chip.dataset.cmd ?? '')
      const original = chip.dataset.label ?? (chip.textContent ?? '')
      chip.textContent = ok ? '✓' : '✗'
      chip.classList.toggle('is-failed', !ok)
      setTimeout(() => {
        chip.textContent = original
        chip.classList.remove('is-failed')
      }, ok ? 1400 : 2600)
    })
  }

  const exportBtn = document.querySelector<HTMLElement>('.export-btn')
  exportBtn?.addEventListener('click', () => {
    /*
     * 从当前按钮自身取状态节点，不依赖全局 id：
     * 导出按钮在模板里有**两个分支**（是否带 copy 按钮决定布局），
     * 只有一个分支带 id。走到另一支时 getElementById 返回 null，
     * 状态提示会静默消失。
     */
    const status = exportBtn.querySelector<HTMLElement>('.export-status')
    const blob = new Blob([mdText], { type: 'text/markdown' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = 'SKILL.md'
    a.click()
    /*
     * 浏览器消费 blob URL 是**异步**的，同步 revoke 会在下载开始前
     * 就把它释放掉（Firefox / Safari 上表现为下载被取消）。
     * 延后 10 秒是安全余量：此时下载早已开始或完成。
     */
    setTimeout(() => URL.revokeObjectURL(url), 10_000)
    // 成功也给一句反馈：浏览器可能拦截下载，用户需要知道「点了」
    if (status) {
      status.textContent = status.dataset.done ?? ''
      setTimeout(() => { status.textContent = '' }, 2000)
    }
  })

  const likeBtn = document.querySelector<HTMLElement>('.like-btn')
  if (likeBtn) {
    const key = 'hamster:like:' + location.pathname
    const seed = Number(likeBtn.dataset.seed || 0)
    const countEl = likeBtn.querySelector('.like-count')
    const heartEl = likeBtn.querySelector('.heart')
    let liked = localStorage.getItem(key) === '1'
    const paintLike = () => {
      if (countEl) countEl.textContent = String(seed + (liked ? 1 : 0))
      if (heartEl) heartEl.textContent = liked ? '♥' : '♡'
      likeBtn.classList.toggle('liked', liked)
    }
    likeBtn.addEventListener('click', () => {
      liked = !liked
      localStorage.setItem(key, liked ? '1' : '0')
      paintLike()
    })
    paintLike()
  }

  const upBtn = document.querySelector<HTMLElement>('.vote-btn.up')
  const downBtn = document.querySelector<HTMLElement>('.vote-btn.down')
  if (upBtn && downBtn) {
    const key = 'hamster:vote:' + location.pathname
    const upSeed = Number(upBtn.dataset.seed || 0)
    let vote = localStorage.getItem(key) || ''
    const paintVote = () => {
      const upCount = upBtn.querySelector('.up-count')
      const downCount = downBtn.querySelector('.down-count')
      if (upCount) upCount.textContent = String(upSeed + (vote === 'up' ? 1 : 0))
      if (downCount) downCount.textContent = String(vote === 'down' ? 1 : 0)
      upBtn.classList.toggle('voted', vote === 'up')
      downBtn.classList.toggle('voted', vote === 'down')
    }
    upBtn.addEventListener('click', () => {
      vote = vote === 'up' ? '' : 'up'
      vote ? localStorage.setItem(key, vote) : localStorage.removeItem(key)
      paintVote()
    })
    downBtn.addEventListener('click', () => {
      vote = vote === 'down' ? '' : 'down'
      vote ? localStorage.setItem(key, vote) : localStorage.removeItem(key)
      paintVote()
    })
    paintVote()
  }
</script>
