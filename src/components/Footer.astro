---
/**
 * 全站页脚。
 *
 * 此前文案是硬编码中文且 Layout 没传 lang，
 * 导致**英文站每一页页脚都显示中文**。
 * 现在接语言包，复用 siteName / siteDesc，不新增翻译键。
 */
import { T } from '../i18n/translations'
import type { Locale } from '../i18n/translations'
import { baseOf } from '../lib/site-paths'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = T[lang]
const base = baseOf(lang)
---

<footer class="site-footer">
  <div class="container">
    <span><span data-site-name>{t.siteName}</span> · <span data-site-desc>{t.siteDesc}</span></span>
    <span class="footer-links">
      <a href={`${base}/about`}>{t.navAbout}</a>
      <a href={`${base}/contact`}>{t.navContact}</a>
      <a href={`${base}/privacy`}>{t.navPrivacy}</a>
    </span>
    <span class="footer-note-line">
      {/* 版权行：默认留空，加载器按后台配置填充；未配置时整段（含分隔点）不显示 */}
      <span data-copyright></span>
      <span data-footer-note>Built with Astro</span>
    </span>
  </div>
</footer>