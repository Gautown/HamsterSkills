---
import type { CollectionEntry } from 'astro:content'
import SkillCard from './SkillCard.astro'
import { CATEGORY_KEYS, CATEGORY_NAMES } from '../lib/categories'
import { T, type Locale } from '../i18n/translations'

interface Props {
  locale: Locale
  skills: CollectionEntry<'skills'>[]
}

const { locale, skills } = Astro.props
const t = T[locale]
const base = locale === 'en' ? '/en' : ''
const counts: Record<string, number> = { all: skills.length }
for (const key of CATEGORY_KEYS) {
  counts[key] = skills.filter(s => s.data.category === key).length
}
const tagCount = new Set(skills.flatMap(s => s.data.tags)).size
// 首页只内联前 N 张卡片，其余由「加载全部」按需 fetch JSON 客户端渲染（控制 HTML 体积）
const GRID_PREVIEW = 150
const previewSkills = skills.slice(0, GRID_PREVIEW)
---

<div class="container">
  <section class="hero">
    <p class="eyebrow">{t.heroEyebrow}</p>

    {/*
      标题行：标题在左，两个 CTA 按钮在右，纵向排列且与 .stats 的每格等宽。
      排序控件不在这里——它属于下面技能网格的 section-head。
    */}
    <div class="hero-head">
      <h1>{t.heroTitle}</h1>
      <div class="cta-row">
        <a class="btn btn-filled" href="#skill-grid">{t.browseAll} →</a>
        <a class="btn btn-outline" href={`${base}/categories`}>{t.viewCategories}</a>
      </div>
    </div>

    <p class="hero-sub">{t.heroSub}</p>

    <div class="stats">
      <div class="stat">
        <div class="stat-value">{skills.length}</div>
        <div class="stat-label">{t.statSkills}</div>
      </div>
      <div class="stat">
        <div class="stat-value">{CATEGORY_KEYS.length}</div>
        <div class="stat-label">{t.statCategories}</div>
      </div>
      <div class="stat">
        <div class="stat-value">ZH·EN</div>
        <div class="stat-label">{t.statLanguages}</div>
      </div>
      <div class="stat">
        <div class="stat-value">{tagCount}</div>
        <div class="stat-label">{t.statTags}</div>
      </div>
    </div>

    {/*
      搜索框已移到导航栏（Header.astro），这里只保留「试试这些」快捷词。
      快捷词会写回导航栏的输入框并触发同一套筛选。
    */}
    <div class="try-links">
      <span class="label">{t.tryLabel}</span>
      {t.tryLinks.map((term: string) => (
        <button type="button" data-try={term}>{term}</button>
      ))}
    </div>
  </section>

  <section>
    <div class="section-head">
      <div>
        <p class="eyebrow">{t.gridEyebrow}</p>
        <h2>{t.gridTitle}</h2>
      </div>
      {/*
        排序控件紧贴它实际作用的技能网格标题行，靠 section 右边缘对齐。
        （此前被放在 hero 里，位置离技能网格太远。）
      */}
      <div class="sort-row" role="group" aria-label={t.sortLabel}>
        <span class="sort-label">{t.sortLabel}</span>
        <button class="sort-btn active" type="button" data-sort="default" aria-pressed="true">{t.sortDefault}</button>
        <button class="sort-btn" type="button" data-sort="score" aria-pressed="false">{t.sortScore}</button>
        <button class="sort-btn" type="button" data-sort="likes" aria-pressed="false">{t.sortLikes}</button>
      </div>
    </div>

    {/*
      分类筛选改为左侧栏：
      - 桌面端（≥960px）与技能网格两列并排，筛选栏 sticky 跟随滚动
      - 窄屏折叠为顶部一个「分类」按钮，点击展开（.chips-toggle）
      按钮的 class 仍是 chip / chip.active，data-cat 不变，
      因此下方按 .chip 查询与切换 active 的脚本无需改动。
    */}
    <button class="chips-toggle" type="button" id="chips-toggle" aria-expanded="false" aria-controls="filter-sidebar">
      <span>{t.sidebarToggle}</span>
      <svg class="chips-caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
      </svg>
    </button>

    <div class="grid-layout">
      <aside class="filter-sidebar" id="filter-sidebar">
        <p class="filter-title">{t.sidebarTitle}</p>
        <div class="chips">
          <button class="chip active" type="button" data-cat="all">
            {t.all} <span class="count">{counts.all}</span>
          </button>
          {CATEGORY_KEYS.map(key => (
            <button class="chip" type="button" data-cat={key}>
              {CATEGORY_NAMES[locale][key]} <span class="count">{counts[key]}</span>
            </button>
          ))}
        </div>
      </aside>

      <div class="grid-main">
        <ul
          class="grid"
          id="skill-grid"
          data-i18n={JSON.stringify({
            base,
            locale,
            githubLabel: t.githubLabel,
            copyPrompt: t.copyPrompt,
            loading: t.loadingAll,
            failed: t.loadFailed,
            catZh: CATEGORY_NAMES.zh,
            catEn: CATEGORY_NAMES.en,
          })}
        >
          {previewSkills.map((entry, i) => <SkillCard entry={entry} lang={locale} rank={i + 1} />)}
        </ul>
        {skills.length > GRID_PREVIEW && (
          <div class="grid-more" id="grid-more">
            <p class="grid-hint">
              {t.gridLimited.replace('{shown}', String(previewSkills.length)).replace('{total}', String(skills.length))}
            </p>
            <button class="btn btn-outline" id="load-all" type="button">{t.loadAllBtn}</button>
          </div>
        )}
        <p id="skill-empty" class="empty hidden">{t.empty}</p>
      </div>
    </div>
  </section>
</div>

<script>
  // 卡片渲染抽到 skill-card.mjs：搜索结果页渲染同样的卡片，
  // 复制一份必然随改卡片样式而漂移。
  import { cardHtml as renderCardHtml } from '../lib/skill-card.ts'

  type IndexItem = import('../lib/skill-card.ts').IndexItem
  interface IndexLabels {
    base: string
    locale: 'zh' | 'en'
    githubLabel: string
    copyPrompt: string
    loading: string
    failed: string
    catZh: Record<string, string>
    catEn: Record<string, string>
  }

  const INDEX_URL = `${import.meta.env.BASE_URL}skills-index.json`
  const grid = document.getElementById('skill-grid')
  // 搜索输入框已移到导航栏（Header.astro），全站共用同一个元素
  const input = (document.getElementById('nav-search-input') ?? document.getElementById('skill-search')) as HTMLInputElement | null
  const empty = document.getElementById('skill-empty')
  const more = document.getElementById('grid-more')
  const hint = more?.querySelector<HTMLElement>('.grid-hint') ?? null
  const loadBtn = document.getElementById('load-all')
  const labels = JSON.parse(grid?.dataset.i18n ?? '{}') as IndexLabels
  let cards = Array.from(grid?.querySelectorAll<HTMLElement>('.card') ?? [])
  let originalOrder = [...cards]
  let activeCat = 'all'
  let activeSort = 'default'
  let loaded = false
  let loadState: 'idle' | 'loading' | 'error' = 'idle'

  const cardHtml = (item: IndexItem, rank: number) => renderCardHtml(item, rank, labels)

  async function loadAll(): Promise<void> {
    if (loaded || loadState === 'loading' || !grid) return
    loadState = 'loading'
    if (hint) hint.textContent = labels.loading
    try {
      const res = await fetch(INDEX_URL, { headers: { accept: 'application/json' } })
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      const data = (await res.json()) as { items: IndexItem[] }
      grid.innerHTML = data.items.map((item, index) => cardHtml(item, index + 1)).join('')
      cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'))
      originalOrder = [...cards]
      loaded = true
      loadState = 'idle'
      more?.classList.add('hidden')
      applySort()
      applyFilter()
    } catch {
      loadState = 'error'
      if (hint) hint.textContent = labels.failed
    }
  }

  function ensureFull(): Promise<void> {
    // 已加载完成时返回 resolved promise，便于 .then() 链式使用
    if (loaded) return Promise.resolve()
    return loadAll()
  }

  function applyFilter(): void {
    const q = (input?.value || '').trim().toLowerCase()
    let visible = 0
    for (const card of cards) {
      const okCat = activeCat === 'all' || card.dataset.category === activeCat
      const okQ = !q || (card.dataset.search || '').includes(q)
      const show = okCat && okQ
      card.classList.toggle('hidden', !show)
      if (show) visible++
    }
    /*
     * 索引还没加载完时**不能**报「没有匹配」。
     *
     * 首次输入会触发 ensureFull() 拉 JSON（实测 ~165ms），
     * 但 applyFilter() 是同步执行的，此刻 cards 里只有首屏内联的 150 张。
     * 用户搜「scraping」若这 150 张里没有，就会先看到一句
     * 「没有匹配的技能」，几百毫秒后索引到了才自我纠正 —— 提示闪一下。
     * 判据：只要还有加载中的可能性，就先不说「没有」。
     */
    const maybeIncomplete = !loaded && loadState !== 'error'
    empty?.classList.toggle('hidden', visible > 0 || maybeIncomplete)
  }

  function applySort(): void {
    let ordered = [...cards]
    if (activeSort === 'score') ordered.sort((a, b) => Number(b.dataset.score || 0) - Number(a.dataset.score || 0))
    else if (activeSort === 'likes') ordered.sort((a, b) => Number(b.dataset.likes || 0) - Number(a.dataset.likes || 0))
    else ordered = originalOrder
    ordered.forEach((card, i) => {
      grid?.appendChild(card)
      const rankEl = card.querySelector('.card-rank')
      if (rankEl) rankEl.textContent = String(i + 1).padStart(2, '0')
    })
  }

  const chips = Array.from(document.querySelectorAll<HTMLElement>('.chip'))
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.cat ?? 'all'
      chips.forEach(c => c.classList.toggle('active', c === chip))
      ensureFull()
      applyFilter()
      // 窄屏下选完分类自动收起侧栏，把屏幕让给结果
      if (window.matchMedia('(max-width: 959px)').matches) closeSidebar()
    })
  }

  /* ---------- 窄屏侧栏折叠 ---------- */
  const sidebar = document.getElementById('filter-sidebar')
  const sidebarToggle = document.getElementById('chips-toggle')
  function openSidebar() {
    if (!sidebar) return
    sidebar.classList.add('open')
    sidebarToggle?.setAttribute('aria-expanded', 'true')
  }
  function closeSidebar() {
    if (!sidebar) return
    sidebar.classList.remove('open')
    sidebarToggle?.setAttribute('aria-expanded', 'false')
  }
  sidebarToggle?.addEventListener('click', () => {
    if (!sidebar) return
    sidebar.classList.contains('open') ? closeSidebar() : openSidebar()
  })
  // 视口放大到桌面尺寸时，清掉窄屏的展开态，避免与桌面并排布局冲突
  const mqSidebar = window.matchMedia('(min-width: 960px)')
  mqSidebar.addEventListener('change', e => {
    if (e.matches) closeSidebar()
  })

  /* ---------- 搜索联动 ---------- */
  /**
   * 显式搜索（点「试试这些」快捷词、或跨页事件）后跳到网格。
   *
   * 与「边打字边筛」不同：这里是用户明确要看搜索结果，
   * 所以**等全量索引就位再滚动**，避免滚过去看到的还是首屏那 150 张。
   *
   * 滚动行为遵循 prefers-reduced-motion：平滑滚动对前庭功能障碍用户
   * 是实际伤害，不是单纯的观感问题。
   */
  function runSearch(q: string) {
    if (input) input.value = q
    void ensureFull().then(() => {
      applyFilter()
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      grid?.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' })
    })
  }

  // 「试试这些」快捷词：写回导航栏输入框并就地筛选
  for (const tryBtn of document.querySelectorAll<HTMLElement>('.try-links button')) {
    tryBtn.addEventListener('click', () => runSearch(tryBtn.dataset.try || ''))
  }

  // 导航栏搜索框在本页提交时派发的自定义事件（Header.astro 负责跨页跳转）
  window.addEventListener('hamster:search', e => {
    runSearch((e as CustomEvent<string>).detail ?? '')
  })

  /*
   * 支持带 ?search= 直接访问（从详情页/分类页搜索后跳转过来，
   * 或分享链接、刷新页面）。Header 已把参数回填到输入框，这里补执行筛选。
   */
  const initialQuery = new URLSearchParams(location.search).get('search')?.trim() ?? ''
  if (initialQuery) {
    if (input) input.value = initialQuery
    // 等按需加载的索引就绪后再筛选，否则只过滤了内联的 150 张
    ensureFull().then(() => {
      applyFilter()
      grid?.scrollIntoView({ block: 'start' })
    })
  }

  loadBtn?.addEventListener('click', () => {
    if (loadState === 'error') loadState = 'idle'
    ensureFull()
  })

  const sortBtns = Array.from(document.querySelectorAll<HTMLElement>('.sort-btn'))
  for (const btn of sortBtns) {
    btn.addEventListener('click', () => {
      sortBtns.forEach(b => {
        const on = b === btn
        b.classList.toggle('active', on)
        // 视觉与语义必须同步，只换 class 的话读屏仍认为旧的生效
        b.setAttribute('aria-pressed', on ? 'true' : 'false')
      })
      activeSort = btn.dataset.sort ?? 'default'
      ensureFull()
      applySort()
      applyFilter()
    })
  }

  input?.addEventListener('input', () => {
    /*
     * 后台预取全量索引，但**不 await**。
     *
     * 旧写法 `ensureFull(); applyFilter()` 里，ensureFull 只是发起
     * fetch 就返回，applyFilter 紧接着同步执行 —— 于是用户每敲一个字母
     * 都要在首屏那 150 张上先筛一遍，而全量结果要等 fetch 回来才出现。
     * 首次输入尤其突兀：输入框已显示关键词，网格里却还是原来的 150 张。
     *
     * 改成后台预取后，输入立刻响应，索引到位时 loadAll 末尾会
     * 自行 applyFilter() 补上全量结果，用户无感知。
     */
    ensureFull()
    applyFilter()
  })
</script>

<style>
  .grid-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 22px 0 6px;
    text-align: center;
  }

  .grid-more .grid-hint {
    margin: 0;
    font-size: 13px;
    opacity: 0.75;
  }
</style>
