---
/**
 * 全站聊天窗。
 *
 * 位置：固定在视口右边缘、垂直居中（top: 50% + translateY(-50%)），
 * 面板向左展开，避开页面主体的阅读区。
 *
 * 为什么必须走后端：站点全静态，AI_API_KEY 若出现在前端 JS 里，
 * 任何人查看源代码即可拿走。所以浏览器只与本站 /api/chat 通信，
 * 由 Worker 持密钥调用 LLM。
 *
 * 当前页面的技能上下文（若有）会随请求一起发往 Worker，
 * 让回答能结合用户正在看的那条技能展开。
 */
import { T } from '../i18n/translations'
import type { Locale } from '../i18n/translations'

interface Props {
  lang: Locale
  /** 当前页面的技能信息；非技能详情页为 undefined */
  skill?: {
    id: string
    title: string
    category?: string
    description?: string
  }
}

const { lang, skill } = Astro.props
const t = T[lang]

// 语言包以 JSON 形式注入，避免在 DOM 里堆一堆 data-* 属性
const strings = {
  title: t.chatTitle,
  placeholder: t.chatPlaceholder,
  send: t.chatSend,
  thinking: t.chatThinking,
  greeting: t.chatGreeting,
  errorGeneric: t.chatErrorGeneric,
  contextBadge: t.chatContextBadge,
  open: t.chatOpen,
  close: t.chatClose,
}
---

<!--
  外层 .chat-widget 只承担数据传递：文案包与当前技能上下文放在 data-* 上，
  供下方脚本读取。内层 .chat-dock 才是定位与交互的容器。
-->
<div
  class="chat-widget"
  data-strings={JSON.stringify(strings)}
  data-skill={skill ? JSON.stringify(skill) : undefined}
>
<div class="chat-dock" id="chat-dock" data-open="false">
  <div class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
    <div class="chat-head">
      <div class="chat-head-text">
        <h2 class="chat-title" id="chat-title">{strings.title}</h2>
        <span class="chat-model">agnes-3.0-flash</span>
      </div>
      <button class="chat-icon-btn" type="button" id="chat-close" aria-label={strings.close}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
      </button>
    </div>

    {skill && (
      <p class="chat-context" id="chat-context">
        {strings.contextBadge.replace('{title}', skill.title.slice(0, 40))}
      </p>
    )}

    <div class="chat-log" id="chat-log" aria-live="polite">
      <p class="chat-bubble chat-bubble-bot">{strings.greeting}</p>
    </div>

    <form class="chat-input-row" id="chat-form">
      <textarea
        class="chat-input"
        id="chat-input"
        rows="1"
        placeholder={strings.placeholder}
        maxlength="2000"
      ></textarea>
      <button class="chat-send" type="submit" id="chat-send" aria-label={strings.send}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10l14-7-5 7 5 7z" /></svg>
      </button>
    </form>
  </div>

  <button class="chat-launcher" type="button" id="chat-launcher" aria-label={strings.open} aria-expanded="false">
    <svg class="chat-icon-open" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 11.5a8.5 8.5 0 01-8.5 8.5c-1.2 0-2.4-.25-3.5-.7L4 21l1.7-4.6A8.5 8.5 0 1121 11.5z" />
    </svg>
    <svg class="chat-icon-close" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</div>
</div>

<!--
  is:global —— 整个聊天窗是全局的。
  Astro 默认给每个选择器追加 data-astro-cid-* 作用域属性，而聊天窗里
  绝大多数节点是脚本 createElement / innerHTML 造出来的，永远不会有该属性：
  作用域规则 .chat-bubble[data-astro-cid-x] 一条都匹配不上，气泡会退化成
  无背景、无边框、无内边距的裸文本（错误气泡连红色都没有）。

  块内 61 个选择器全部以 chat- / #chat- 前缀，没有一个裸元素或 .chat 之外的
  通用类，因此放开作用域不会影响站内其它组件。
-->
<style is:global>
  /*
    固定在视口右下角，「面板 + 按钮」作为一个整体。
    - right / bottom 统一管边距，面板和按钮都靠这条边对齐
    - DOM 顺序是「面板 → 按钮」，所以用 column（不是 column-reverse）：
      面板排在上方往上长，按钮留在右下角不动
    - align-items: flex-end 让面板右边缘与按钮右边缘齐平；
      不用它的话 340px 的面板会按 stretch 拉伸，与按钮错开
    - z-index 高于吸顶导航，避免被遮挡
  */
  .chat-dock {
    position: fixed;
    right: var(--dock-inset, 20px);
    bottom: var(--dock-inset, 20px);
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    /*
      三个尺寸绑成变量，供 .chat-panel 算自身高度上限。
      面板并非贴视口底边：它下方还压着按钮和间距，
      所以可用高度要减掉这三项，漏算任何一项面板就会顶出视口顶端
      （曾漏算按钮，1080px 视口下面板顶端跑到 -38px）。
    */
    --launcher-size: 46px;
    --panel-gap: 12px;
  }

  /* ---------- 悬浮按钮 ---------- */

  .chat-launcher {
    width: var(--launcher-size, 46px);
    height: var(--launcher-size, 46px);
    /* 外边距交给 .chat-dock 统一管，这里保持 0 */
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-4);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .chat-launcher:hover {
    transform: scale(1.06);
    border-color: var(--accent);
  }

  .chat-launcher:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .chat-launcher svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 两个图标交叉淡入淡出，展开/收起时不用换 DOM */
  .chat-icon-close {
    display: none;
  }

  .chat-dock[data-open='true'] .chat-icon-open {
    display: none;
  }

  .chat-dock[data-open='true'] .chat-icon-close {
    display: block;
  }

  /* ---------- 面板 ---------- */

  .chat-panel {
    width: 340px;
    /* 左右各留一个 dock 内边距，面板不会顶到屏幕左边 */
    max-width: calc(100vw - var(--dock-inset, 20px) * 2);
    /* 面板右边缘由 dock 的 right 定位，这里只留与按钮的竖向间距 */
    margin-bottom: var(--panel-gap, 12px);
    /*
      面板整体不许超出视口。日志区上限已翻倍到 92vh，
      内容高度会超过一屏，靠这条上限把多出来的部分挤回
      .chat-log 内部滚动，而不是顶出屏幕顶端。
      减去的三项分别是：dock 离底、按钮高度、按钮上方的间距。
    */
    max-height: calc(
      100vh - var(--dock-inset, 20px) - var(--launcher-size, 46px) - var(--panel-gap, 12px)
    );
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-4);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chat-panel[hidden] {
    display: none;
  }

  /*
  标题栏用实心蓝底。

  背景写死 #0078D4 而不是 var(--accent)：深色模式下 --accent 是浅蓝 #4cc2ff，
  配白字会看不清（对比度约 1.6:1）。字面值在明暗两种模式下都能保证可读。
  白字配 #0078D4 对比度约 4.6:1，达 WCAG AA 正文标准。
*/
.chat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    /* 蓝底已经起到分隔作用，再叠一条线在深色模式下会变成一道深色缝 */
    background: #0078d4;
  }

  .chat-head-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .chat-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: #fff;
  }

  /*
  模型名不再展示。
  「在跟哪个模型对话」原本是想给用户透明度，但现在后台限流时
  这个标签只会让人误以为「模型选错了」，反而制造困惑 —— 真正的
  问题在服务商侧，展示模型名解决不了。

  元素保留在 DOM 里（而不是删掉），万一将来要恢复展示不必改模板。
  */
  .chat-model {
    display: none;
  }

  /* 关闭按钮：蓝底上必须用白字，否则深灰图标几乎看不见 */
  .chat-icon-btn {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  /* 悬停用半透明白色叠加；原先的深色叠加在蓝底上几乎看不出变化 */
  .chat-icon-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .chat-icon-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .chat-context {
    margin: 0;
    padding: 7px 14px;
    font-size: 11px;
    color: var(--accent);
    background: var(--accent-soft, rgba(56, 132, 255, 0.08));
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- 消息区 ---------- */

  .chat-log {
    flex: 1;
    /*
      高度翻倍：220px → 440px，46vh → 92vh。

      min-height 是 max(220px, min(440px, 46vh))，两头都要：
      - 内层 min(440px, 46vh)：视口够高（≥ ~957px）时给满 440px，
        不够时按比例缩，避免固定下限把面板顶出屏幕
      - 外层 max(220px, …)：兜住缩过头的情况。矮视口下
        46vh 可能低于原来的 220px，若不兜底日志区反而比以前更矮
      （实测 443px 高的窗口：46vh = 204px < 220px）

      上限交给 .chat-panel 的 max-height 兜底，面板不会超出视口。
    */
    min-height: max(220px, min(440px, 46vh));
    max-height: 92vh;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .chat-bubble {
    margin: 0;
    padding: 8px 11px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.6;
    max-width: 88%;
    /* 模型偶尔会输出较长内容，避免长串把气泡撑破 */
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .chat-bubble-bot {
    align-self: flex-start;
    background: var(--surface-2, rgba(0, 0, 0, 0.04));
    border: 1px solid var(--line);
  }

  .chat-bubble-user {
    align-self: flex-end;
    background: var(--accent);
    color: #fff;
  }

  .chat-bubble-error {
    align-self: flex-start;
    border: 1px solid #e5484d;
    color: #e5484d;
    background: rgba(229, 72, 77, 0.08);
  }

  /* ---------- 气泡内的 Markdown ---------- */

  /*
   * .chat-bubble 的 white-space: pre-wrap 是为纯文本气泡准备的。
   * Markdown 渲染后子元素变成块级（p / ul / pre…），pre-wrap 会在它们之间
   * 再插一层空白，看起来像双倍行距，所以这里必须换回 normal，
   * 换行改由 marked 的 breaks（单换行出 <br>）负责。
   */
  .chat-bubble-md {
    white-space: normal;
  }

  /* 气泡自带 padding，段落的上下外边距要收掉，否则每段都多出一截 */
  .chat-bubble-md > :first-child {
    margin-top: 0;
  }
  .chat-bubble-md > :last-child {
    margin-bottom: 0;
  }

  .chat-bubble-md p {
    margin: 0 0 6px;
  }

  .chat-bubble-md ul,
  .chat-bubble-md ol {
    margin: 0 0 6px;
    padding-left: 20px;
  }

  .chat-bubble-md li {
    margin: 0 0 2px;
  }

  .chat-bubble-md li > ul,
  .chat-bubble-md li > ol {
    margin: 2px 0 0;
  }

  .chat-bubble-md a {
    color: var(--accent);
    text-decoration: underline;
  }

  .chat-bubble-md code {
    padding: 1px 4px;
    border-radius: 4px;
    background: rgba(127, 127, 127, 0.16);
    font-family: 'Cascadia Code', Consolas, 'Courier New', monospace;
    font-size: 0.92em;
  }

  /*
   * 代码块必须能横向滚动。气泡有 max-width: 88%，
   * 一行长代码若不滚会把整个面板撑破（overflow-wrap: anywhere 会把代码折断）。
   */
  .chat-bubble-md pre {
    margin: 0 0 6px;
    padding: 8px 10px;
    border-radius: 8px;
    background: rgba(127, 127, 127, 0.14);
    overflow-x: auto;
    overflow-wrap: normal;
  }

  .chat-bubble-md pre code {
    padding: 0;
    background: none;
    font-size: 0.92em;
  }

  .chat-bubble-md blockquote {
    margin: 0 0 6px;
    padding-left: 9px;
    border-left: 3px solid var(--line);
    color: var(--muted);
  }

  .chat-bubble-md h1,
  .chat-bubble-md h2,
  .chat-bubble-md h3,
  .chat-bubble-md h4,
  .chat-bubble-md h5,
  .chat-bubble-md h6 {
    margin: 8px 0 4px;
    font-size: 1.04em;
    line-height: 1.4;
  }

  .chat-bubble-md hr {
    margin: 8px 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  /*
   * 表格用 display:block 换行滚动：
   * 助手偶尔会吐出宽表格，直接铺开会把气泡顶得比面板还宽。
   */
  .chat-bubble-md table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 0 0 6px;
    border-collapse: collapse;
  }

  .chat-bubble-md th,
  .chat-bubble-md td {
    padding: 3px 7px;
    border: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }

  .chat-bubble-md th {
    background: rgba(127, 127, 127, 0.12);
    font-weight: 600;
  }

  /* ---------- 输入区 ---------- */

  .chat-input-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid var(--line);
  }

  .chat-input {
    flex: 1;
    min-width: 0;
    /* 最多 5 行，超出则内部滚动 */
    max-height: 96px;
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 13px;
    line-height: 1.5;
    resize: none;
  }

  .chat-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .chat-send {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: none;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .chat-send:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .chat-send svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  /* 等待模型回复时的三点动画 */
  .chat-dots::after {
    content: '…';
    animation: chat-blink 1.2s steps(4, end) infinite;
  }

  @keyframes chat-blink {
    0%,
    20% {
      content: '';
    }
    40% {
      content: '.';
    }
    60% {
      content: '..';
    }
    80%,
    100% {
      content: '...';
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-launcher,
    .chat-dots::after {
      transition: none;
      animation: none;
    }
  }

  /*
    窄屏：只调边距与宽度。
    右下角布局在窄屏同样成立（基础样式已经如此），
    但 340px 的面板在 375px 屏上会顶到左边，所以放宽到几乎占满。
  */
  @media (max-width: 560px) {
    .chat-dock {
      right: 14px;
      bottom: 14px;
      --dock-inset: 14px;
    }

    .chat-panel {
      width: calc(100vw - 28px);
      max-width: none;
    }

    .chat-log {
      max-height: 84vh;
    }
  }

  /* 打印时隐藏，避免出现在打印出来的纸上 */
  @media print {
    .chat-dock {
      display: none;
    }
  }
</style>

<script>
  /**
   * 聊天窗交互。
   *
   * 用 data 属性与 CSS 协作：展开/收起只切 data-open，
   * 图标交叉淡入、面板显隐都由 CSS 完成，JS 不碰样式细节。
   */
  interface ChatStrings {
    title: string
    placeholder: string
    send: string
    thinking: string
    greeting: string
    errorGeneric: string
    contextBadge: string
    open: string
    close: string
  }

  interface ApiEvent {
    type?: 'meta' | 'delta' | 'error' | 'done'
    text?: string
    message?: string
    /** 流开始之前的失败（HTTP 4xx/5xx）用的字段 */
    error?: string
  }

  interface SkillContext {
    id: string
    title: string
    category?: string
    description?: string
  }

  function bootChat(root: HTMLElement) {
    const dock = root.querySelector<HTMLElement>('#chat-dock')
    const panel = root.querySelector<HTMLElement>('#chat-panel')
    const launcher = root.querySelector<HTMLButtonElement>('#chat-launcher')
    const closeBtn = root.querySelector<HTMLButtonElement>('#chat-close')
    const form = root.querySelector<HTMLFormElement>('#chat-form')
    const input = root.querySelector<HTMLTextAreaElement>('#chat-input')
    const sendBtn = root.querySelector<HTMLButtonElement>('#chat-send')
    const log = root.querySelector<HTMLElement>('#chat-log')
    if (!dock || !panel || !launcher || !form || !input || !sendBtn || !log) return

    const strings = JSON.parse(root.dataset.strings ?? '{}') as ChatStrings
    const skill = root.dataset.skill ? (JSON.parse(root.dataset.skill) as SkillContext) : null

    /**
     * Markdown 渲染器按需加载。
     *
     * 聊天窗挂在全站每一页上，而绝大多数访客从不点开它。marked 加渲染器
     * 约 40KB，静态 import 会让每页首屏都背上这份成本；动态 import 拆成独立
     * chunk，只在真的发消息时才拉，首屏字节数不变。
     */
    type MarkdownRenderer = (text: string) => string
    /** 加载失败时的兜底：仍然转义，只是丢掉 Markdown 语法，聊天气泡不会因此不可用 */
    const escapeOnly: MarkdownRenderer = (text) =>
      text.replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!
      )
    let renderer: MarkdownRenderer | null = null
    let rendererLoading: Promise<MarkdownRenderer> | null = null

    function loadRenderer(): Promise<MarkdownRenderer> {
      if (renderer) return Promise.resolve(renderer)
      rendererLoading ??= import('../lib/chat-markdown.mjs')
        .then((m) => m.renderChatMarkdown)
        .catch(() => escapeOnly)
        .then((fn) => (renderer = fn))
      return rendererLoading
    }

    /**
     * 流式回复的绘制器。
     *
     * 模型每秒吐 30~60 个 delta，逐帧重解析整段 Markdown 会反复重排日志区，
     * 肉眼看就是气泡高度抖动。80ms 节流看不出来，却能把重绘压到 1/6。
     * flush 会在流结束时补一次同步重绘，保证末尾内容一定落到 DOM。
     */
    function makeStreamPainter(el: HTMLElement) {
      let latest = ''
      let timer: ReturnType<typeof setTimeout> | undefined
      let pending: Promise<MarkdownRenderer> | null = null

      function paint() {
        timer = undefined
        // 复用同一个 Promise；latest 在 then 里才读，期间到达的 delta 会被一并带上
        pending ??= loadRenderer()
        void pending.then((fn) => {
          el.innerHTML = fn(latest)
        })
      }

      return {
        push(text: string) {
          latest = text
          el.classList.add('chat-bubble-md')
          timer ??= setTimeout(paint, 80)
        },
        async flush() {
          if (timer !== undefined) {
            clearTimeout(timer)
            timer = undefined
          }
          el.innerHTML = (await loadRenderer())(latest)
        },
        /** 气泡被丢弃（出错或空回复）时撤掉待触发的重绘，避免往已移除的节点上写 */
        discard() {
          if (timer !== undefined) {
            clearTimeout(timer)
            timer = undefined
          }
        },
      }
    }

    /** 送往后端的对话历史（只保留 user/assistant，不含系统提示） */
    const history: Array<{ role: 'user' | 'assistant'; content: string }> = []
    let busy = false

    const isOpen = () => dock.dataset.open === 'true'

    function setOpen(open: boolean) {
      dock.dataset.open = String(open)
      panel.hidden = !open
      launcher.setAttribute('aria-expanded', String(open))
      if (open) {
        input.focus()
      } else {
        launcher.focus()
      }
    }

    /*
      面板打开时把页面其余部分设为 inert。
      否则 Tab 会从输入框一路跑到背后的导航与正文——聊天窗是覆盖在
      内容之上的浮层，键盘用户会「消失」在背景里找不到回来的路。
      inert 同时会阻止背景里的链接被激活，比逐个改 tabindex 干净。
    */
    function setBackgroundInert(inert: boolean) {
      for (const node of document.body.children) {
        if (node === root) continue
        if (inert) {
          node.setAttribute('inert', '')
        } else {
          node.removeAttribute('inert')
        }
      }
    }

    function scrollToEnd() {
      log.scrollTop = log.scrollHeight
    }

    function addBubble(text: string, kind: 'user' | 'bot' | 'error'): HTMLElement {
      const p = document.createElement('p')
      p.className = `chat-bubble chat-bubble-${kind}`
      p.textContent = text
      log.appendChild(p)
      scrollToEnd()
      return p
    }

    /** 输入框随内容增高，到 5 行封顶后改为内部滚动 */
    function autoGrow() {
      input.style.height = 'auto'
      input.style.height = `${Math.min(input.scrollHeight, 96)}px`
    }

    async function send() {
      const content = input.value.trim()
      if (!content || busy) return

      busy = true
      sendBtn.disabled = true
      input.value = ''
      autoGrow()
      addBubble(content, 'user')
      history.push({ role: 'user', content })

      // 「思考中」占位：收到第一个 delta 后被同一个气泡替换
      const pending = addBubble(strings.thinking, 'bot')
      pending.classList.add('chat-dots')
      // 真正承载回复的气泡，与 pending 同位置，靠切换 display 复用。
      // 用 div 而非 p：回复是 Markdown，会渲染出 ul / pre / table 等块级元素，
      // 塞进 <p> 是无效内容模型（p 只允许 phrasing content）。
      const target = document.createElement('div')
      target.className = 'chat-bubble chat-bubble-bot'
      target.hidden = true
      pending.after(target)
      const painter = makeStreamPainter(target)

      let reply = ''
      let failed = false
      let quotaBlocked = false

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: history.slice(-20),
            context: skill ?? undefined,
          }),
        })

        if (!res.ok || !res.body) {
          // 流开始之前的失败仍是普通 JSON，能拿到明确的错误文案
          const data = (await res.json().catch(() => ({}))) as ApiEvent
          // 429 = 限流或额度耗尽，重试也无意义
          quotaBlocked = res.status === 429
          throw new Error(data.error ?? data.message ?? strings.errorGeneric)
        }

        target.hidden = false
        pending.remove()

        const reader = res.body.getReader()
        const decoder = new TextDecoder()
        let buffer = ''

        while (true) {
          const { value, done } = await reader.read()
          if (done) break
          buffer += decoder.decode(value, { stream: true })

          // SSE 以空行分隔事件；这里按 data: 行切分即可（本站协议无多行字段）
          let newline = buffer.indexOf('\n')
          while (newline !== -1) {
            const line = buffer.slice(0, newline).trim()
            buffer = buffer.slice(newline + 1)
            newline = buffer.indexOf('\n')
            if (!line.startsWith('data:')) continue

            const payload = line.slice(5).trim()
            if (!payload) continue

            let event: ApiEvent
            try {
              event = JSON.parse(payload) as ApiEvent
            } catch {
              continue
            }

            if (event.type === 'delta' && event.text) {
              reply += event.text
              painter.push(reply)
              scrollToEnd()
            } else if (event.type === 'error') {
              throw new Error(event.message ?? strings.errorGeneric)
            }
          }
        }

        // 收尾必须同步补一次：节流窗口内的最后几十个字符还没落到 DOM
        await painter.flush()

        if (!reply) {
          // 流正常结束但一个字都没有：模型返回了空内容
          failed = true
          painter.discard()
          target.remove()
          addBubble(strings.errorGeneric, 'error')
        } else {
          history.push({ role: 'assistant', content: reply })
        }
      } catch (error) {
        failed = true
        painter.discard()
        pending.remove()
        target.remove()
        addBubble(error instanceof Error ? error.message : strings.errorGeneric, 'error')
      } finally {
        busy = false
        sendBtn.disabled = false
        input.focus()
      }

      /*
        只有额度被拒绝时才丢弃历史：
        配额是全局的、短期内不会恢复，继续带着历史重试只会再撞 429。
        网络抖动或模型异常则保留历史——用户很可能只是想让模型把刚才那句答完。
      */
      if (failed && quotaBlocked) history.length = 0
    }

    launcher.addEventListener('click', () => {
      const next = !isOpen()
      setOpen(next)
      setBackgroundInert(next)
    })
    closeBtn?.addEventListener('click', () => {
      setOpen(false)
      setBackgroundInert(false)
    })

    form.addEventListener('submit', event => {
      event.preventDefault()
      void send()
    })

    // Enter 发送、Shift+Enter 换行
    input.addEventListener('keydown', event => {
      if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
        event.preventDefault()
        void send()
      }
    })
    input.addEventListener('input', autoGrow)

    // Esc 收起面板
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false)
        setBackgroundInert(false)
      }
    })

    setOpen(false)
  }

  document.querySelectorAll<HTMLElement>('.chat-widget').forEach(bootChat)
</script>
