---
import type { Locale } from '../i18n/translations'

/**
 * Giscus 评论组件（每个 skill 一个独立讨论）。
 *
 * 为什么懒加载：
 *   站内详情页有约 9,000 个（五种语言一套模板，共 4 万多页），每个页面若直接引入
 *   giscus 客户端脚本（约 50 KB）会显著拖慢首屏。这里改为「点开讨论 tab
 *   时才注入脚本」，未点开的页面零开销。
 *
 * 为什么 strict：
 *   strict=1 时 Giscus 只在配置域名下加载。本地 npm run dev / 预览环境
 *   不产生评论，避免在 Discussions 里堆出一堆无意义的测试讨论。
 *
 * 讨论与页面的对应关系：mapping=specific + term=skill id。
 *   选 specific 而非 pathname，是因为各语言页面路径不同（/skills/x 与
 *   /en/skills/x 等），用 pathname 会让同一个 skill 产生多个重复讨论；
 *   用 skill id 则所有语言共享同一个讨论。
 */
interface Props {
  /** skill 唯一标识，作为讨论的映射键（各语言页面共享同一个讨论） */
  term: string
  /** 站点语言，Giscus 界面语言随之切换 */
  locale: Locale
}

const { term, locale } = Astro.props
// Astro.site 来自 astro.config.mjs 的 site（构建时由 SITE_URL 环境变量注入）
const origin = Astro.site?.origin ?? 'https://skill.gautown.top'

/*
 * Giscus 的界面语言映射：ko 有官方翻译，zh-tw 用 zh-TW；
 * ms 暂无 Giscus 官方语言包，退回英文界面。
 * 组件自身的几条内联提示按 zh / zh-tw / en 三档本地化（ko/ms 用英文档）。
 */
const giscusLang = locale === 'zh' ? 'zh-CN' : locale === 'zh-tw' ? 'zh-TW' : locale === 'ko' ? 'ko' : 'en'
const noscriptText =
  locale === 'en' || locale === 'ko' || locale === 'ms'
    ? 'Comments require JavaScript. Please open the discussion on GitHub.'
    : locale === 'zh-tw'
      ? '留言功能需要 JavaScript，請前往 GitHub 討論區參與。'
      : '评论功能需要 JavaScript，请前往 GitHub 讨论区参与。'
const noscriptLink =
  locale === 'en' || locale === 'ko' || locale === 'ms'
    ? 'Open on GitHub'
    : locale === 'zh-tw'
      ? '在 GitHub 上討論 ↗'
      : '在 GitHub 上讨论 ↗'
---

<div class="giscus-host" data-term={term} data-locale={locale} data-origin={origin} />

<noscript>
  <p class="giscus-fallback">
    {noscriptText}
    <a
      href={`https://github.com/Gautown/HamsterSkills/discussions/new?category=general&title=${encodeURIComponent(term)}`}
      target="_blank"
      rel="noopener">{noscriptLink}</a>
  </p>
</noscript>

<style>
  .giscus-host {
    min-height: 120px;
  }

  .giscus-fallback {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    margin: 0;
    padding: 14px 0;
  }

  .giscus-fallback a {
    color: var(--accent-text);
  }

  /* 骨架占位：脚本加载完成前给一个中性提示，避免页面看起来是空的 */
  .giscus-loading {
    color: var(--muted);
    font-size: 13px;
    padding: 24px 0;
    text-align: center;
  }
</style>

<script>
  /**
   * Giscus 按需注入。
   *
   * 由详情页在首次切到「讨论」tab 时调用；同一页面重复调用不会重复注入。
   */
  /** 与 frontmatter 的 giscusLang 同一映射；脚本块独立作用域，按 dataset 再算一遍 */
  function giscusLangOf(locale: string): string {
    return locale === 'zh' ? 'zh-CN' : locale === 'zh-tw' ? 'zh-TW' : locale === 'ko' ? 'ko' : 'en'
  }

  function mountGiscus(host: HTMLElement) {
    if (host.dataset.mounted === '1') return
    host.dataset.mounted = '1'

    const locale = host.dataset.locale ?? 'zh'
    const loadingText =
      locale === 'en' || locale === 'ko' || locale === 'ms'
        ? 'Loading comments…'
        : locale === 'zh-tw'
          ? '正在載入留言…'
          : '正在加载评论…'
    const failText =
      locale === 'en' || locale === 'ko' || locale === 'ms'
        ? 'Failed to load comments.'
        : locale === 'zh-tw'
          ? '留言載入失敗，請稍後重試。'
          : '评论加载失败，请稍后重试。'

    const placeholder = document.createElement('div')
    placeholder.className = 'giscus-loading'
    placeholder.textContent = loadingText
    host.appendChild(placeholder)

    const script = document.createElement('script')
    script.src = 'https://giscus.app/client.js'
    script.async = true
    script.crossOrigin = 'anonymous'
    // 用 setAttribute 传值：Giscus 通过 data-* 读取配置
    script.setAttribute('data-repo', 'Gautown/HamsterSkills')
    script.setAttribute('data-repo-id', 'R_kgDOVEdjJA')
    script.setAttribute('data-category', 'General')
    script.setAttribute('data-category-id', 'DIC_kwDOVEdjJM4DH_Vd')
    script.setAttribute('data-mapping', 'specific')
    script.setAttribute('data-term', host.dataset.term ?? '')
    // 仅在配置域名下加载；本地开发与预览环境不产生讨论
    script.setAttribute('data-strict', '1')
    script.setAttribute('data-reactions-enabled', '1')
    script.setAttribute('data-emit-metadata', '0')
    script.setAttribute('data-input-position', 'top')
    script.setAttribute('data-theme', 'preferred_color_scheme')
    script.setAttribute('data-lang', giscusLangOf(locale))
    script.setAttribute('data-loading', 'lazy')
    script.addEventListener('load', () => placeholder.remove())
    script.addEventListener('error', () => {
      placeholder.textContent = failText
    })
    host.appendChild(script)
  }

  // 暴露给详情页的 tab 切换逻辑调用
  ;(window as unknown as { mountGiscus?: (el: HTMLElement) => void }).mountGiscus = mountGiscus

  // 首屏若已带 hash（#discussion）则直接挂载，支持链接直达
  if (location.hash === '#discussion') {
    const host = document.querySelector<HTMLElement>('.giscus-host')
    if (host) mountGiscus(host)
  }
</script>