---
import type { CollectionEntry } from 'astro:content'
import { CATEGORY_KEYS, CATEGORY_NAMES } from '../lib/categories'
import { T, type Locale } from '../i18n/translations'

interface Props {
  locale: Locale
  skills: CollectionEntry<'skills'>[]
}

const { locale, skills } = Astro.props
const t = T[locale]
const base = locale === 'en' ? '/en' : ''
---

<div class="container">
  <p class="eyebrow">{t.catsEyebrow}</p>
  <div class="cat-head">
    <div>
      <h1>{t.categoriesTitle}</h1>
      <p class="sub">{t.categoriesSub}</p>
    </div>
    <div class="cat-count-block">
      <span class="count-big">{skills.length}</span>
      <span class="count-label">{t.skillsInCategory}</span>
    </div>
  </div>
  <ul class="grid">
    {CATEGORY_KEYS.map(key => {
      const count = skills.filter(s => s.data.category === key).length
      return (
        <li class="cat-card">
          <a href={`${base}/categories/${key}`}>
            <span class="cat-name">{CATEGORY_NAMES[locale][key]}</span>
            <span class="cat-count"><strong>{count}</strong> {t.skillsInCategory}</span>
            <span class="cat-arrow">→</span>
          </a>
        </li>
      )
    })}
  </ul>
</div>
