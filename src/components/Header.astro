---
/**
 * 站点导航。
 *
 * 桌面端：全部技能 / 分类 / 标签 三个入口固定显示，后两者各带下拉
 *   - 分类下拉：10 个固定分类，带技能数
 *   - 标签下拉：热门标签（技能数 ≥ HOT_TAG_MIN），带技能数
 *     实测 1217 个标签里有 864 个只出现 1 次，全部塞进菜单会不可用，
 *     因此只放热门项并提供「查看全部」入口。
 * 窄屏（≤900px）：三个入口 + 主题 + 语言收进汉堡面板
 */
import { getCollection } from 'astro:content'
import { CATEGORY_KEYS, CATEGORY_NAMES } from '../lib/categories'
import { tagSlug } from '../lib/tags'
import { baseOf, homePathOf, searchPathOf } from '../lib/site-paths'
import { T, type Locale } from '../i18n/translations'
import { FLAG_SVG } from '../lib/flags'
import { LANG_META, LOCALES, stripBase } from '../lib/languages'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = T[lang]
const base = baseOf(lang)
const pathname = Astro.url.pathname

/**
 * 语言菜单：当前页面在五种语言下的同位置入口。
 * 与 hreflang 同一套推导（stripBase 抹掉当前前缀 → 各语言补前缀）。
 */
const langLinks = LOCALES.map(l => ({
  code: l,
  label: LANG_META[l].label,
  href: `${LANG_META[l].base}${stripBase(pathname, lang)}`,
}))
const flagOf = (code: Locale) => FLAG_SVG[code]

/** 进入标签下拉的最小技能数；实测 ≥10 的标签共 16 个，菜单长度可控 */
const HOT_TAG_MIN = 10

/*
 * 每个页面都重新聚合 8,900 条 skill 会拖慢构建，
 * 因此把结果缓存到模块级变量（同一构建内多次调用只算一次）。
 */
let cachedCategories: { key: string; label: string; count: number }[] | undefined
let cachedTags: { slug: string; tag: string; count: number }[] | undefined

async function navData() {
  if (cachedCategories && cachedTags) return { categories: cachedCategories, tags: cachedTags }
  const skills = await getCollection('skills')

  cachedCategories = CATEGORY_KEYS.map(key => ({
    key,
    label: CATEGORY_NAMES[lang][key],
    count: skills.filter(s => s.data.category === key).length,
  }))

  const counts = new Map<string, { tag: string; count: number }>()
  for (const s of skills) {
    for (const tag of s.data.tags) {
      const slug = tagSlug(tag)
      const cur = counts.get(slug)
      if (cur) cur.count++
      else counts.set(slug, { tag, count: 1 })
    }
  }
  cachedTags = [...counts.entries()]
    .map(([slug, info]) => ({ slug, ...info }))
    .filter(x => x.count >= HOT_TAG_MIN)
    .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))

  return { categories: cachedCategories, tags: cachedTags }
}

const { categories, tags } = await navData()

const isActive = (href: string) =>
  href === (base || '/') ? pathname === '/' || pathname === base || pathname === `${base}/` : pathname.startsWith(href)

/** 首页地址：品牌链接与「已在首页就地筛选」的判据都用它 */
const homePath = homePathOf(lang)
/**
 * 搜索结果页地址。
 *
 * 原来表单 action 指向首页，只有首页才有筛选脚本，
 * 于是从技能详情页/标签页/分类页提交搜索会跳回首页，
 * 用户得自己再点一次搜索才能看到结果。现在全站都指向搜索结果页。
 */
const searchPath = searchPathOf(lang)
/** 已在首页时直接就地筛选，不必跳转 */
const onHome = pathname === '/' || pathname === homePath || pathname === `${homePath}/`
const currentQuery = Astro.url.searchParams.get('search') ?? ''
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homePath}>
      <img class="brand-logo" src="/logo.svg" alt={t.siteName} width="48" height="48" />
      <span>{t.siteName}</span>
    </a>

    {/*
      全站搜索框：占据品牌与导航之间的剩余空间。
      提交一律跳到搜索结果页（该页自带完整索引与 IDF 检索），
      首页的 ?search= 过滤保留，用于「已在首页时直接就地筛选」。
    */}
    <form class="nav-search" id="nav-search" role="search" action={searchPath} method="get">
      <input
        class="nav-search-input"
        id="nav-search-input"
        type="search"
        name="search"
        value={currentQuery}
        placeholder={t.searchPlaceholder}
        aria-label={t.searchPlaceholder}
      />
      <button class="nav-search-btn" type="submit" aria-label={t.searchBtn} title={t.searchBtn}>
        <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6" fill="none" />
          <path d="M11 11l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </form>

    <nav aria-label="主导航">
      <a class="nav-link" href={base || '/'} aria-current={isActive(base || '/') ? 'page' : undefined}>
        {t.navSkills}
      </a>

      {/* 分类下拉：父链接可点，下拉列出 10 个分类 */}
      <details class="nav-drop" id="nav-cat">
        <summary class:list={['nav-drop-summary', { active: pathname.startsWith(`${base}/categories`) }]}>
          {t.navCategories}
          <svg class="nav-caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav-drop-menu">
          <a href={`${base}/categories`} class="nav-drop-all">{t.navViewAllCategories} →</a>
          {categories.map(c => (
            <a href={`${base}/categories/${c.key}`}>
              <span class="nav-drop-label">{c.label}</span>
              <span class="nav-drop-count">{c.count.toLocaleString()}</span>
            </a>
          ))}
        </div>
      </details>

      {/* 标签下拉：热门标签 + 查看全部 */}
      <details class="nav-drop" id="nav-tag">
        <summary class:list={['nav-drop-summary', { active: pathname.startsWith(`${base}/tags`) }]}>
          {t.navTags}
          <svg class="nav-caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav-drop-menu">
          <a href={`${base}/tags`} class="nav-drop-all">{t.navViewAllTags} →</a>
          {tags.map(tag => (
            <a href={`${base}/tags/${tag.slug}`}>
              <span class="nav-drop-label">{tag.tag}</span>
              <span class="nav-drop-count">{tag.count.toLocaleString()}</span>
            </a>
          ))}
        </div>
      </details>

      {/*
        主题按钮：文字换成图标。
        两个图标都渲染在 DOM 里，由 CSS 按当前主题显示其一——
        图标状态因此不依赖 JS，脚本只负责更新读屏文案。
        aria-label 描述「点击后会发生什么」（切换到深色/浅色）而非当前状态，
        因为按钮的用途就是「切到那个」。
      */}
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        data-label-dark={t.themeToDark}
        data-label-light={t.themeToLight}
        aria-label={t.themeToDark}
        title={t.themeToDark}
      >
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" />
        </svg>
      </button>
      {/*
        语言按钮：地球图标 + 下拉菜单（旗帜-语言名）。
        复用 nav-drop 的 details 互斥/外点关闭逻辑；菜单项 HTML 与桌面版相同。
      */}
      <details class="nav-drop lang-drop" id="nav-lang">
        <summary class="lang-toggle" aria-label={t.langSwitchLabel} title={t.langSwitchLabel}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a14 14 0 010 18a14 14 0 010-18z" />
          </svg>
        </summary>
        <div class="nav-drop-menu lang-menu">
          {langLinks.map(l => (
            <a
              href={l.href}
              class:list={['lang-item', { current: l.code === lang }]}
              aria-current={l.code === lang ? 'true' : undefined}
            >
              <span class="flag" set:html={flagOf(l.code)} />
              <span class="lang-name">{l.label}</span>
              {l.code === lang && (
                <span class="lang-check" aria-hidden="true">✓</span>
              )}
            </a>
          ))}
        </div>
      </details>

      {/* 窄屏汉堡按钮：仅 ≤900px 显示 */}
      <button
        class="nav-burger"
        type="button"
        id="nav-burger"
        aria-label={t.navMenu}
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <span class="burger-bar" /><span class="burger-bar" /><span class="burger-bar" />
      </button>
    </nav>
  </div>

  {/* 窄屏展开面板：JS 控制显隐 */}
  <div class="nav-mobile" id="nav-mobile" hidden>
    <div class="container">
      {/* 窄屏下导航栏搜索框隐藏，改由这里提供 */}
      <form class="nav-search nav-search-mobile" id="nav-search-mobile" role="search" action={searchPath} method="get">
        <input
          class="nav-search-input"
          type="search"
          name="search"
          value={currentQuery}
          placeholder={t.searchPlaceholder}
          aria-label={t.searchPlaceholder}
        />
        <button class="nav-search-btn" type="submit" aria-label={t.searchBtn} title={t.searchBtn}>
          <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6" fill="none" />
            <path d="M11 11l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </form>
      <a href={homePath} class:list={{ active: isActive(homePath) }}>{t.navSkills}</a>
      <a href={`${base}/categories`} class:list={{ active: pathname.startsWith(`${base}/categories`) }}>
        {t.navCategories}
      </a>
      <a href={`${base}/tags`} class:list={{ active: pathname.startsWith(`${base}/tags`) }}>{t.navTags}</a>
      <div class="nav-mobile-foot">
        {/*
          窄屏面板里的副本，与桌面版结构相同。
          两个主题按钮由 [data-theme-toggle] 统一同步。
        */}
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          data-label-dark={t.themeToDark}
          data-label-light={t.themeToLight}
          aria-label={t.themeToDark}
          title={t.themeToDark}
        >
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" />
          </svg>
        </button>
        /*
          窄屏面板里的语言菜单：与桌面版同一份 HTML。
          details/summary 的开合不依赖 JS；外点关闭/互斥由同一套 .nav-drop 监听覆盖。
        */
        <details class="nav-drop lang-drop lang-drop-mobile">
          <summary class="lang-toggle" aria-label={t.langSwitchLabel} title={t.langSwitchLabel}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3a14 14 0 010 18a14 14 0 010-18z" />
            </svg>
          </summary>
          <div class="nav-drop-menu lang-menu">
            {langLinks.map(l => (
              <a
                href={l.href}
                class:list={['lang-item', { current: l.code === lang }]}
                aria-current={l.code === lang ? 'true' : undefined}
              >
                <span class="flag" set:html={flagOf(l.code)} />
                <span class="lang-name">{l.label}</span>
                {l.code === lang && (
                  <span class="lang-check" aria-hidden="true">✓</span>
                )}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<script>
  /* ---------- 主题切换 ---------- */
  const mq = window.matchMedia('(prefers-color-scheme: dark)')
  const isDark = () => {
    const o = document.documentElement.dataset.theme
    return o ? o === 'dark' : mq.matches
  }
  /*
    桌面与移动面板各有一个主题按钮，需同步。
    按钮内是图标（由 CSS 按主题显示），脚本不碰图标，只更新
    aria-label 与 title——描述「点下去会切到哪个主题」。
  */
  const themeBtns = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-toggle]'))
  const paintThemes = () => {
    const dark = isDark()
    for (const b of themeBtns) {
      const label = dark ? b.dataset.labelLight : b.dataset.labelDark
      if (label) {
        b.setAttribute('aria-label', label)
        b.setAttribute('title', label)
      }
    }
  }
  for (const btn of themeBtns) {
    btn.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark'
      document.documentElement.dataset.theme = next
      /*
       * 写入同样要兜住：无痕模式 / 禁用站点数据时 localStorage.setItem
       * 会抛 SecurityError。这里若不 catch，异常会中断整个处理器，
       * 结果是**主题变了但没存下来**，paintThemes() 不执行，
       * 用户刷新一下就被打回原样 —— 比不保存更难解释。
       * 存不下就算了，本次会话内的切换仍然有效。
       */
      try {
        localStorage.setItem('hamster:theme', next)
      } catch {}
      paintThemes()
    })
  }
  paintThemes()
  // 用户没手动选过时，系统主题可能在运行中变化（跟随系统切换的浏览器）
  mq.addEventListener('change', () => {
    if (!document.documentElement.dataset.theme) paintThemes()
  })

  /* ---------- 全站搜索 ---------- */
  /*
   * 三种情况：
   *   已在搜索结果页 → 派发 hamster:search，由该页就地换查询词（不重载）
   *   已在首页       → 派发 hamster:search，由 HomePage 就地过滤（不重载）
   *   其它页面      → 走 <form action> 正常跳到 /search/?search=xxx
   *
   * 原先非首页一律跳回首页，但首页要用户再点一次搜索才真正筛选，
   * 等于搜索框在 8809 个技能详情页 + 数千个标签/分类页上都是半残的。
   */
  const searchForm = document.getElementById('nav-search') as HTMLFormElement | null
  const searchInput = document.getElementById('nav-search-input') as HTMLInputElement | null
  const mobileInput = document.querySelector<HTMLInputElement>('.nav-search-mobile input')
  const onHomePage = /^\/(?:en|zh-tw|ko|ms)?\/?$/.test(location.pathname)
  const onSearchPage = /^\/(?:en|zh-tw|ko|ms)?\/?search\/?$/.test(location.pathname)
  const canFilterInPlace = onHomePage || onSearchPage

  /*
   * 静态站点在构建期不知道用户会带什么查询参数，所以 value 只能在客户端回填。
   * 同时同步汉堡面板里的那个输入框，两处始终一致。
   */
  const urlQuery = new URLSearchParams(location.search).get('search') ?? ''
  if (urlQuery) {
    if (searchInput) searchInput.value = urlQuery
    if (mobileInput) mobileInput.value = urlQuery
  }

  if (searchForm && searchInput) {
    searchForm.addEventListener('submit', e => {
      if (!canFilterInPlace) return // 跨页：交给浏览器默认提交到 /search/
      e.preventDefault()
      const q = searchInput.value.trim()
      // 同步到地址栏，便于分享/刷新后保留条件
      const url = new URL(location.href)
      if (q) url.searchParams.set('search', q)
      else url.searchParams.delete('search')
      history.replaceState(null, '', url)
      if (mobileInput) mobileInput.value = q
      window.dispatchEvent(new CustomEvent('hamster:search', { detail: q }))
    })
  }

  // 汉堡面板里的表单同样按页面决定是否就地筛选
  const mobileForm = document.getElementById('nav-search-mobile') as HTMLFormElement | null
  if (mobileForm && mobileInput) {
    mobileForm.addEventListener('submit', e => {
      if (!canFilterInPlace) return
      e.preventDefault()
      const q = mobileInput.value.trim()
      const url = new URL(location.href)
      if (q) url.searchParams.set('search', q)
      else url.searchParams.delete('search')
      history.replaceState(null, '', url)
      if (searchInput) searchInput.value = q
      window.dispatchEvent(new CustomEvent('hamster:search', { detail: q }))
    })
  }

  /* ---------- 下拉菜单：点外部 / Esc 关闭，且互斥 ---------- */
  const drops = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-drop'))
  for (const drop of drops) {
    drop.addEventListener('toggle', () => {
      // 展开一个时收起其它，避免两个菜单同时挂着
      if (drop.open) for (const other of drops) if (other !== drop) other.open = false
    })
    document.addEventListener('click', e => {
      if (drop.open && !drop.contains(e.target as Node)) drop.open = false
    })
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && drop.open) {
        drop.open = false
        ;(drop.querySelector('summary') as HTMLElement | null)?.focus()
      }
    })
  }

  /* ---------- 窄屏汉堡菜单 ---------- */
  const burger = document.getElementById('nav-burger')
  const mobile = document.getElementById('nav-mobile')
  if (burger && mobile) {
    burger.addEventListener('click', () => {
      const open = mobile.hidden
      mobile.hidden = !open
      burger.setAttribute('aria-expanded', String(open))
      burger.classList.toggle('open', open)
    })
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !mobile.hidden) {
        mobile.hidden = true
        burger.setAttribute('aria-expanded', 'false')
        burger.classList.remove('open')
        burger.focus()
      }
    })
    // 视口放大到桌面尺寸时收起面板，避免残留
    const mqWide = window.matchMedia('(min-width: 901px)')
    const sync = () => {
      if (mqWide.matches && !mobile.hidden) {
        mobile.hidden = true
        burger.setAttribute('aria-expanded', 'false')
        burger.classList.remove('open')
      }
    }
    mqWide.addEventListener('change', sync)
    sync()
  }
</script>