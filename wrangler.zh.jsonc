{
  // 中文站 Worker：静态资产 + Cron 定时刷新 + 手动刷新端点
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamster-skills-zh",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-zh",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 聊天端点用它读取 skills-index.json 作为站内检索索引。
    // 加绑定不改变路由：run_worker_first 仍是 /api/*，静态请求依旧绕过 Worker。
    "binding": "ASSETS",
    // 仅让 API 路径进入 Worker，其余请求由静态资产层直接响应（省免费版 10 万次/天请求额度）
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // 每日 UTC 03:17（北京时间 11:17）；必须 ≥1 小时间隔才有 15 分钟 CPU 额度
    "crons": ["17 3 * * *"]
  },
  // 仓库标识：Worker 用它触发本仓库的 Actions 工作流（需与实际仓库一致）
  "vars": {
    "GITHUB_REPO": "Gautown/HamsterSkills",
    // 聊天端点用（AI_API_KEY 走 secret，不在 vars 里）
    "AI_API_BASE": "https://api.agnes-ai.cn/v1",
    "AI_MODEL": "agnes-3.0-flash",
    // 双重限额：每 IP 每分钟最多 N 条，全站每天最多 M 条
    "CHAT_RATE_LIMIT": "3",
    "CHAT_DAILY_LIMIT": "500"
  },
  // 全站每日聊天额度计数器（KV 免费额度：10 万读/天、1000 写/天，500 条/天远在限额内）
  "kv_namespaces": [
    {
      "binding": "CHAT_QUOTA",
      "id": "4a8aabdd830f4a28b1cfaf12b00e77ad"
    }
  ],
  "observability": {
    "enabled": true
  },
  // 自定义域名：中文站占用根路径，英文站占用 /en/*（两者同 zone，互不重叠）
  // zone_name 填域名所属的 zone（skill.gautown.top 是子域名，zone 是 gautown.top）
  // pattern 才是完整的自定义域名
  "routes": [{ "pattern": "skill.gautown.top/*", "zone_name": "gautown.top" }]
}