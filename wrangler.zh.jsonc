{
  // 中文站 Worker：静态资产 + Cron 定时刷新 + 手动刷新端点
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamster-skills-zh",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-zh",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 仅让 API 路径进入 Worker，其余请求由静态资产层直接响应（省免费版 10 万次/天请求额度）
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // 每日 UTC 03:17（北京时间 11:17）；必须 ≥1 小时间隔才有 15 分钟 CPU 额度
    "crons": ["17 3 * * *"]
  },
  // 仓库标识：Worker 用它触发本仓库的 Actions 工作流（需与实际仓库一致）
  "vars": {
    "GITHUB_REPO": "Gautown/HamsterSkills"
  },
  "observability": {
    "enabled": true
  },
  // 自定义域名：中文站占用根路径，英文站占用 /en/*（两者同 zone，互不重叠）
  // 前提：skill.gautown.top 的 DNS 已托管在 Cloudflare
  "routes": [{ "pattern": "skill.gautown.top/*", "zone_name": "skill.gautown.top" }]
}