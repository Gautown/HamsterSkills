# 可选：GitHub Token，API 限额从 60 提升到 5000 次/小时（"尽量全"的自动发现建议设置）
GITHUB_TOKEN=

# 可选：追加显式聚合仓库（逗号分隔，owner/repo[:category]），与自动发现结果合并
SKILLS_REPOS=

# 可选：自动发现公开 skill 仓库（默认开启）
# 关闭：SKILLS_DISCOVER=0
# SKILLS_TOPICS=agent-skills,claude-skills,claude-code-skills,opencode-skills,opencode-skill,hermes-skills
# SKILLS_MIN_STARS=0
# SKILLS_MAX_REPOS=300
# SKILLS_MAX_SKILLS_PER_REPO=200
# SKILLS_MAX_SKILLS=12000
# 发现结果缓存时长（小时），0 = 每次构建都重新发现
# SKILLS_DISCOVER_TTL_HOURS=24

# 可选：GitHub API / 原始文件地址（镜像或企业版时覆盖）
# GITHUB_API_BASE=https://api.github.com
# GITHUB_RAW_BASE=https://raw.githubusercontent.com

# ---- AI 分类（npm run ai-classify）----
# 未配置 AI_API_KEY 时脚本会直接跳过，规则层分类照常生效，不影响站点运行。
#
# 必填：API 密钥（不要提交到 git；.env 已在 .gitignore 中）
AI_API_KEY=
# 可选：接口地址与模型
# AI_API_BASE=https://api.agnes-ai.cn/v1
# AI_MODEL=agnes-3.0-flash
#
# 说明：结果按「skill id + 内容 sha」记忆化存在 .cache/ai-classify.json，
# 内容未变的条目永远不重复调用 API，成本只随新增/变更条目增长。

# ---- 质量门槛（只作用于站点构建；不设即不启用对应项）----
# 低于此 star 数的仓库直接排除。实测 300 个候选里拦下 31 个。
SKILLS_MIN_QUALITY_STARS=100
# 低于此 fork 数的仓库直接排除。
# 需求原本是「下载次数低于 1000」，但 GitHub 公开 API 不提供下载/clone 次数，
# 这里用 fork 代替（公开 API 里最接近「有人真拿了一份去用」的信号）。
# 曾按字面取 1000，实测会砍掉 82% 的仓库；取 100 时只误杀 1 个高星仓。
SKILLS_MIN_QUALITY_FORKS=100
# README 没有可照做的用法示例（代码块/安装命令/编号步骤/frontmatter）时排除。
# 设为 0 可关闭这一项。
SKILLS_REQUIRE_USAGE_EXAMPLE=1
