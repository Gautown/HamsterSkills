# 可选：GitHub Token，API 限额从 60 提升到 5000 次/小时（"尽量全"的自动发现建议设置）
GITHUB_TOKEN=

# 可选：追加显式聚合仓库（逗号分隔，owner/repo[:category]），与自动发现结果合并
SKILLS_REPOS=

# 可选：自动发现公开 skill 仓库（默认开启）
# 关闭：SKILLS_DISCOVER=0
# SKILLS_TOPICS=agent-skills,claude-skills,claude-code-skills,opencode-skills,opencode-skill,hermes-skills
# SKILLS_MIN_STARS=0
# SKILLS_MAX_REPOS=300
# SKILLS_MAX_SKILLS_PER_REPO=200
# SKILLS_MAX_SKILLS=12000
# 发现结果缓存时长（小时），0 = 每次构建都重新发现
# SKILLS_DISCOVER_TTL_HOURS=24

# 可选：GitHub API / 原始文件地址（镜像或企业版时覆盖）
# GITHUB_API_BASE=https://api.github.com
# GITHUB_RAW_BASE=https://raw.githubusercontent.com
